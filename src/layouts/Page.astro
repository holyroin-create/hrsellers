---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sources from '../components/Sources.astro';
const { title, description, eyebrow = '', lede = '', crumbs = [], noindex = false, updated = '', og, jsonld = [], cites = [] } = Astro.props as any;
(Astro.locals as any).citeOrder = cites;
---
<Base title={title} description={description} noindex={noindex} og={og} jsonld={jsonld}>
  <div class="wrap">
    <Breadcrumbs trail={[...crumbs, { label: title, href: Astro.url.pathname }]} />
    <div class="page-narrow">
      <header class="index-head" style="border:0;padding-bottom:0">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {lede && <p class="lede">{lede}</p>}
        {updated && <p class="meta">Last updated {updated}</p>}
      </header>
      <div class="prose"><slot /></div>
      {cites.length > 0 && <Sources />}
    </div>
  </div>
</Base>
