---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Sources from '../components/Sources.astro';
const { title, description, kicker = '', lede = '', photo, trail = [], noindex = false, noCanonical = false, jsonld = [], cites = [], updated = '', wide = false } = Astro.props as any;
(Astro.locals as any).citeOrder = cites;
---
<Base title={title} description={description} noindex={noindex} noCanonical={noCanonical} jsonld={jsonld}>
  <PageHero title={title} lede={lede} kicker={kicker} photo={photo} trail={trail} />
  <div class="wrap legal">
    <div class={wide ? '' : 'narrow'}>
      {updated && <p class="muted" style="font-size:.9rem">Last updated {updated}</p>}
      <div class="prose"><slot /></div>
      {cites.length > 0 && <Sources />}
    </div>
  </div>
</Base>
