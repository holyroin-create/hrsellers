---
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { SITE, ADS_ON } from '../lib/site';
interface Props { title: string; description: string; og?: string; noindex?: boolean; noCanonical?: boolean; jsonld?: object[]; ads?: boolean; type?: string; preload?: string }
const { title, description, og = '/og/default.png', noindex = false, noCanonical = false, jsonld = [], ads = false, type = 'website', preload } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.domain).href;
const full = Astro.url.pathname === '/' ? `${SITE.siteName}: ${title}` : title.length > 52 ? title : `${title} | ${SITE.siteName}`;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>
  <meta name="description" content={description} />
  {!noCanonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="google-adsense-account" content={SITE.adsensePublisherId} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="FBA Tactics policy log" href="/rss.xml" />
  {preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
  <meta property="og:site_name" content={SITE.siteName} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(og, SITE.domain).href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0b1f33" />
  <noscript><style>.nav{display:flex}.mega{display:grid;position:static;box-shadow:none}</style></noscript>
  {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  {ADS_ON && ads && <script is:inline>try{var c=localStorage.getItem('fbt-consent');(window.adsbygoogle=window.adsbygoogle||[]).requestNonPersonalizedAds=c==='accept'?0:1}catch(e){(window.adsbygoogle=window.adsbygoogle||[]).requestNonPersonalizedAds=1}</script>}
  {ADS_ON && ads && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsensePublisherId}`} crossorigin="anonymous"></script>}
</head>
<body>
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <Consent />
</body>
</html>
