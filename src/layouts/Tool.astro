---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import Sources from '../components/Sources.astro';
const { title, description, lede, cites = [], photo = 'hub-tools' } = Astro.props as any;
(Astro.locals as any).citeOrder = cites;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, applicationCategory: 'BusinessApplication', operatingSystem: 'Any', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, url: new URL(Astro.url.pathname, 'https://fbatactics.com').href }];
---
<Base title={title} description={description} jsonld={ld}>
  <PageHero title={title} lede={lede} kicker="Free calculator" photo={photo} trail={[{ label: 'Tools', href: '/tools/' }]} />
  <div class="wrap" style="padding-bottom:80px">
    <slot name="calc" />
    <div class="narrow"><div class="prose"><slot /></div>{cites.length > 0 && <Sources />}</div>
  </div>
</Base>
