---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Sources from '../components/Sources.astro';
const { title, description, lede, cites = [] } = Astro.props as any;
(Astro.locals as any).citeOrder = cites;
const ld = [{ '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, applicationCategory: 'BusinessApplication', operatingSystem: 'Any (runs in the browser)', isAccessibleForFree: true, url: new URL(Astro.url.pathname, 'https://fbatactics.com').href }];
---
<Base title={title} description={description} jsonld={ld}>
  <div class="wrap">
    <Breadcrumbs trail={[{ label: 'Tools', href: '/tools/' }, { label: title, href: Astro.url.pathname }]} />
    <header class="index-head" style="border:0;padding-bottom:0"><p class="eyebrow">Calculator</p><h1>{title}</h1><p class="lede">{lede}</p>
      <p class="meta">Runs entirely in your browser. Nothing you enter is sent, stored or tracked.</p></header>
    <slot name="calc" />
    <div class="page-narrow"><div class="prose"><slot /></div>{cites.length > 0 && <Sources />}</div>
  </div>
</Base>
