---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Hero from '../components/Hero.astro';
import Sources from '../components/Sources.astro';
import AdSlot from '../components/AdSlot.astro';
import { fmtDate } from '../lib/claims';
import { SITE } from '../lib/site';
const { data, headings = [], crumb, related = [], og } = Astro.props as any;
const path = Astro.url.pathname;
const ld = [{
  '@context': 'https://schema.org', '@type': 'Article', headline: data.title, description: data.description,
  datePublished: data.published, dateModified: data.modified, mainEntityOfPage: new URL(path, SITE.domain).href,
  image: new URL(og, SITE.domain).href,
  publisher: { '@type': 'Organization', name: SITE.publisherName, url: SITE.domain },
  ...(SITE.ownerConfirmed && SITE.editorName ? { author: { '@type': 'Person', name: SITE.editorName, url: new URL('/about/', SITE.domain).href } } : { author: { '@type': 'Organization', name: SITE.publisherName } }),
}];
const h2 = headings.filter((h: any) => h.depth === 2);
---
<Base title={data.title} description={data.description} og={og} jsonld={ld} ads={true} type="article">
  <div class="wrap">
    <Breadcrumbs trail={[crumb, { label: data.title, href: path }]} />
    <header class="art-head">
      <div>
        <p class="eyebrow">{data.category}</p>
        <h1>{data.title}</h1>
        <p class="lede">{data.description}</p>
        <div class="byline">
          <span>By <a href="/about/#who"><strong>{SITE.publisherName}</strong> editorial</a></span>
          {data.reviewedBy && <span>Reviewed by <a href="/about/#who"><strong>{data.reviewedBy}</strong></a>{data.reviewedDate && <> on <time datetime={data.reviewedDate}>{fmtDate(data.reviewedDate)}</time></>}</span>}
          <span>First published <time datetime={data.published}>{fmtDate(data.published)}</time></span>
          <span>Rewritten from primary sources <time datetime={data.modified}>{fmtDate(data.modified)}</time></span>
          <span class="verified">Last verified: {fmtDate(data.lastVerified)}</span>
          <span>{data.minutes} min read</span>
        </div>
      </div>
      <Hero hero={data.hero} title={data.title} />
    </header>
    <div class="art-body">
      <article class="prose">
        <section class="summary-box" aria-labelledby="sum-h">
          <h2 id="sum-h">In short</h2>
          <ul>{data.summary.map((s: string) => <li>{s}</li>)}</ul>
        </section>
        <slot />
        <Sources />
        {related.length > 0 && (
          <nav class="related" aria-labelledby="rel-h"><h2 id="rel-h">Related</h2>
            <ul>{related.map((r: any) => <li><a href={r.href}>{r.title}</a> <span class="meta">— {r.category}</span></li>)}</ul></nav>
        )}
        <p class="meta" style="margin-top:2rem">Found an error? <a href="/contact/">Tell us</a> — corrections are logged on the <a href="/corrections/">corrections page</a>. This page is general information, not legal, tax or customs advice.</p>
        <AdSlot slot="endOfArticle" />
      </article>
      <aside class="art-aside"><div class="aside-sticky">
        {h2.length > 2 && <nav class="toc" aria-labelledby="toc-h"><p id="toc-h">On this page</p><ol>{h2.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav>}
      </div></aside>
    </div>
  </div>
</Base>
