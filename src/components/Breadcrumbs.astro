---
import { SITE } from '../lib/site';
const { trail = [] } = Astro.props as { trail: { label: string; href: string }[] };
const all = [{ label: 'Home', href: '/' }, ...trail];
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: all.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: t.label, item: new URL(t.href, SITE.domain).href })) };
---
<nav class="crumbs" aria-label="Breadcrumb"><ol>{all.map((t, i) => <li>{i === all.length - 1 ? <span aria-current="page">{t.label}</span> : <a href={t.href}>{t.label}</a>}</li>)}</ol></nav>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
