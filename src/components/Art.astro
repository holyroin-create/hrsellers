---
const { kind = 'ledger', h = 180 } = Astro.props;
---
{kind === 'ledger' && (
<svg class="art" viewBox="0 0 320 200" role="img" aria-label="Abstract invoice reconciliation graphic" style={`height:${h}px`}>
  <rect x="24" y="18" width="200" height="164" rx="3" class="a-panel"/>
  <rect x="44" y="40" width="86" height="7" rx="2" class="a-ink"/>
  <rect x="44" y="60" width="146" height="5" rx="2" class="a-mute"/>
  <rect x="44" y="74" width="120" height="5" rx="2" class="a-mute"/>
  <line x1="44" y1="94" x2="204" y2="94" class="a-rule"/>
  <rect x="44" y="106" width="60" height="5" rx="2" class="a-mute"/>
  <rect x="160" y="106" width="44" height="5" rx="2" class="a-pos"/>
  <rect x="44" y="124" width="72" height="5" rx="2" class="a-mute"/>
  <rect x="164" y="124" width="40" height="5" rx="2" class="a-neg"/>
  <rect x="44" y="142" width="54" height="5" rx="2" class="a-mute"/>
  <rect x="152" y="142" width="52" height="5" rx="2" class="a-pos"/>
  <line x1="44" y1="160" x2="204" y2="160" class="a-rule"/>
  <rect x="140" y="168" width="64" height="7" rx="2" class="a-ink"/>
  <rect x="212" y="66" width="84" height="84" rx="3" class="a-accent"/>
  <path d="M228 118 l14 14 l26 -32" class="a-check"/>
</svg>
)}
{kind === 'freight' && (
<svg class="art" viewBox="0 0 320 200" role="img" aria-label="Abstract freight and routing graphic" style={`height:${h}px`}>
  <rect x="26" y="96" width="120" height="58" rx="3" class="a-panel"/>
  <rect x="146" y="112" width="70" height="42" rx="3" class="a-accent"/>
  <circle cx="66" cy="160" r="13" class="a-ink"/><circle cx="176" cy="160" r="13" class="a-ink"/>
  <circle cx="66" cy="160" r="5" class="a-panel"/><circle cx="176" cy="160" r="5" class="a-panel"/>
  <path d="M40 74 C 96 20, 200 20, 268 56" class="a-route"/>
  <circle cx="40" cy="74" r="6" class="a-pos-f"/><circle cx="268" cy="56" r="6" class="a-neg-f"/>
  <rect x="42" y="110" width="42" height="5" rx="2" class="a-mute"/>
  <rect x="42" y="124" width="60" height="5" rx="2" class="a-mute"/>
</svg>
)}
{kind === 'grid' && (
<svg class="art" viewBox="0 0 320 200" role="img" aria-label="Abstract marketplace comparison grid" style={`height:${h}px`}>
  <rect x="26" y="26" width="268" height="148" rx="3" class="a-panel"/>
  <line x1="26" y1="60" x2="294" y2="60" class="a-rule"/>
  <line x1="118" y1="26" x2="118" y2="174" class="a-rule"/>
  <line x1="196" y1="26" x2="196" y2="174" class="a-rule"/>
  <rect x="42" y="40" width="50" height="6" rx="2" class="a-ink"/>
  <rect x="134" y="40" width="34" height="6" rx="2" class="a-mute"/>
  <rect x="212" y="40" width="34" height="6" rx="2" class="a-mute"/>
  <rect x="42" y="78" width="58" height="5" rx="2" class="a-mute"/>
  <rect x="134" y="78" width="28" height="5" rx="2" class="a-pos"/>
  <rect x="212" y="78" width="40" height="5" rx="2" class="a-neg"/>
  <rect x="42" y="106" width="46" height="5" rx="2" class="a-mute"/>
  <rect x="134" y="106" width="42" height="5" rx="2" class="a-neg"/>
  <rect x="212" y="106" width="26" height="5" rx="2" class="a-pos"/>
  <rect x="42" y="134" width="62" height="5" rx="2" class="a-mute"/>
  <rect x="134" y="134" width="30" height="5" rx="2" class="a-pos"/>
  <rect x="212" y="134" width="36" height="5" rx="2" class="a-pos"/>
</svg>
)}
{kind === 'scale' && (
<svg class="art" viewBox="0 0 320 200" role="img" aria-label="Abstract growth and scaling graphic" style={`height:${h}px`}>
  <rect x="26" y="26" width="268" height="148" rx="3" class="a-panel"/>
  <line x1="52" y1="150" x2="278" y2="150" class="a-rule"/>
  <rect x="62" y="118" width="26" height="32" rx="2" class="a-bar1"/>
  <rect x="102" y="100" width="26" height="50" rx="2" class="a-bar1"/>
  <rect x="142" y="106" width="26" height="44" rx="2" class="a-bar1"/>
  <rect x="182" y="76" width="26" height="74" rx="2" class="a-accent"/>
  <rect x="222" y="58" width="26" height="92" rx="2" class="a-accent"/>
  <path d="M62 128 L115 108 L155 112 L195 84 L245 62" class="a-route"/>
</svg>
)}
