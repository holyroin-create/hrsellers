---
/** Inline mini calculator. variant: 'margin' | 'stack'. Links to the full tool. */
const { variant = 'margin' } = Astro.props;
const uid = 'mc' + Math.random().toString(36).slice(2, 8);
const cfgs = {
  stack: { title: 'Quick duty check', cta: 'Open the full tariff estimator', href: '/tools/tariff-stack-estimator/' },
  ppc: { title: 'Quick ad-cost check', cta: 'Open the full PPC budget calculator', href: '/tools/ppc-budget-calculator/' },
  dim: { title: 'Quick billable-weight check', cta: 'Open the full dimensional weight tool', href: '/tools/dimensional-weight/' },
  margin: { title: 'Quick margin check', cta: 'Open the full margin calculator', href: '/tools/margin-calculator/' },
};
const cfg = cfgs[variant] || cfgs.margin;
---
<aside class="rail-box orange minicalc" id={uid} style="margin:1.8rem 0 2rem;max-width:none">
  <h4 style="margin-top:0">{cfg.title} <span style="font:600 .7rem 'Barlow';letter-spacing:.1em;color:#5a606a">— RUNS IN YOUR BROWSER, STORES NOTHING</span></h4>
  {variant === 'margin' ? (
    <div class="mc-grid">
      <label>Sale price $<input type="number" inputmode="decimal" data-k="p" value="29.99" /></label>
      <label>All fees $<input type="number" inputmode="decimal" data-k="f" value="11.20" /></label>
      <label>Landed cost $<input type="number" inputmode="decimal" data-k="c" value="7.10" /></label>
    </div>
  ) : variant === 'stack' ? (
    <div class="mc-grid">
      <label>Customs value $<input type="number" inputmode="decimal" data-k="v" value="10000" /></label>
      <label>Base + 301 %<input type="number" inputmode="decimal" data-k="a" value="28.4" /></label>
      <label>Other layers %<input type="number" inputmode="decimal" data-k="b" value="10" /></label>
    </div>
  ) : variant === 'ppc' ? (
    <div class="mc-grid">
      <label>Avg CPC $<input type="number" inputmode="decimal" data-k="cpc" value="1.35" /></label>
      <label>Conversion %<input type="number" inputmode="decimal" data-k="cvr" value="10" /></label>
      <label>Target orders/day<input type="number" inputmode="decimal" data-k="ord" value="3" /></label>
    </div>
  ) : (
    <div class="mc-grid">
      <label>L × W × H (in³)<input type="number" inputmode="decimal" data-k="cu" value="864" /></label>
      <label>Scale weight lb<input type="number" inputmode="decimal" data-k="sw" value="3.2" /></label>
      <label>Divisor<input type="number" inputmode="decimal" data-k="dv" value="139" /></label>
    </div>
  )}
  <p class="mc-out" data-out style="font:800 1.05rem 'Barlow';color:#14171b;margin:.7rem 0 .5rem">&nbsp;</p>
  <a href={cfg.href} class="btn cta" style="display:inline-block">{cfg.cta} →</a>
  <script is:inline define:vars={{ uid, variant }}>
    (function () {
      var root = document.getElementById(uid); if (!root) return;
      var out = root.querySelector('[data-out]');
      function g(k) { var el = root.querySelector('[data-k="' + k + '"]'); return parseFloat(el && el.value) || 0; }
      function run() {
        if (variant === 'margin') {
          var p = g('p'), net = p - g('f') - g('c');
          var m = p > 0 ? (net / p) * 100 : 0;
          out.textContent = 'Net ' + (net < 0 ? '-$' : '$') + Math.abs(net).toFixed(2) + ' per unit · margin ' + m.toFixed(1) + '% · break-even ACOS ' + Math.max(0, m).toFixed(1) + '%';
        } else if (variant === 'stack') {
          var eff = g('a') + g('b'), duty = g('v') * eff / 100;
          out.textContent = 'Effective rate ' + eff.toFixed(1) + '% · duty $' + duty.toLocaleString('en-US', { maximumFractionDigits: 0 }) + ' on this shipment';
        } else if (variant === 'ppc') {
          var cpo = g('cvr') > 0 ? g('cpc') / (g('cvr') / 100) : 0;
          out.textContent = 'Cost per ad order $' + cpo.toFixed(2) + ' · daily budget $' + (cpo * g('ord')).toFixed(0) + ' for ' + g('ord') + ' orders/day';
        } else {
          var dim = g('dv') > 0 ? g('cu') / g('dv') : 0; var bill = Math.max(dim, g('sw'));
          out.textContent = 'Dim weight ' + dim.toFixed(2) + ' lb · billable ' + bill.toFixed(2) + ' lb (' + (bill === g('sw') ? 'scale wins' : 'size wins') + ')';
        }
      }
      root.querySelectorAll('input').forEach(function (i) { i.addEventListener('input', run); });
      run();
    })();
  </script>
</aside>
<style>
  .minicalc .mc-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.6rem; }
  .minicalc label { font:600 .78rem 'Barlow', system-ui; color:#3a4048; display:grid; gap:.25rem; }
  .minicalc input { width:100%; padding:.45rem .55rem; border:1px solid #d2d6dc; border-radius:6px; font:600 .95rem 'Barlow'; }
  @media (max-width:560px){ .minicalc .mc-grid { grid-template-columns:1fr; } }
</style>
