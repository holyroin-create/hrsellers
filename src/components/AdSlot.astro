---
/* Renders nothing unless adsEnabled + googleCmpConfigured + a numeric slot id. Only article pages use it. */
import { SITE, ADS_ON } from '../lib/site';
const { slot } = Astro.props as { slot: 'endOfArticle' };
const id = (SITE.adSlots as Record<string, string>)[slot];
const show = ADS_ON && /^\d{6,}$/.test(id || '');
---
{show && <aside class="ad" aria-label="Advertisements"><p class="ad-label">Advertisements</p><ins class="adsbygoogle" style="display:block;min-height:280px" data-ad-client={SITE.adsensePublisherId} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins><script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script></aside>}
