---
/* Renders NOTHING unless adsEnabled AND googleCmpConfigured are true in site.config.json
   AND a slot id exists. Pages that may host ads are limited to guides and marketplace references. */
import { SITE, ADS_ON } from '../lib/site';
interface Props { slot: 'inArticle' | 'endOfArticle' }
const id = (SITE.adSlots as Record<string, string>)[Astro.props.slot];
const show = ADS_ON && /^\d{6,}$/.test(id || '');
---
{show && (
  <aside class="ad" aria-label="Advertisements">
    <p class="ad-label">Advertisements</p>
    <ins class="adsbygoogle" style="display:block;min-height:280px" data-ad-client={SITE.adsensePublisherId} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
