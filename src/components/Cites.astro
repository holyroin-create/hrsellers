---
import { claim, citeNum } from '../lib/claims';
const { ids = [] } = Astro.props as { ids?: string[] };
const order: string[] = (Astro.locals as any).citeOrder || [];
const nums = [...new Map(ids.map((id) => { claim(id); return [citeNum(order, id), id]; })).entries()].sort((a, b) => a[0] - b[0]);
---
{nums.length > 0 && <sup class="cite">{nums.map(([n, id]) => <a href={`#src-${id}`} aria-label={`Source ${n}`}>{n}</a>)}</sup>}
