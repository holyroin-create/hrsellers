---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV } from '../lib/nav';
const path = Astro.url.pathname;
const active = (g: any) => g.base.some((b: string) => path.startsWith(b)) || g.items.some((i: any) => i.href.split('#')[0] === path);
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="wrap hdr">
    <Logo />
    <nav class="nav" id="nav" aria-label="Main">
      <div class={`nav-item nav-articles${path.startsWith('/articles/') ? ' is-active' : ''}`}>
        <a href="/articles/" aria-current={path.startsWith('/articles/') ? 'page' : undefined}><Icon name="doc" />Articles</a>
      </div>
      {NAV.map((g, n) => (
        <div class={`nav-item${active(g) ? ' is-active' : ''}`}>
          <button type="button" aria-expanded="false" aria-controls={`mega-${n}`}>{g.label}<Icon name="chevron" /></button>
          <div class="mega" id={`mega-${n}`}>
            {g.items.map((i) => <a href={i.href}><span class="ico"><Icon name={i.i} /></span><span><b>{i.t}</b><span>{i.d}</span></span></a>)}
          </div>
        </div>
      ))}
    </nav>
    <form class="hdr-search" action="/search/" method="get" role="search">
      <Icon name="search" /><label class="vh" for="hq">Search</label>
      <input id="hq" name="q" type="search" placeholder="Search" autocomplete="off" />
      <button class="vh" type="submit">Search</button>
    </form>
    <a class="btn btn-cta btn-sm" href="/tools/">Free calculators</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" aria-label="Open menu"><Icon name="menu" /></button>
  </div>
</header>
<script>
  const items = [...document.querySelectorAll<HTMLElement>('.nav-item')].filter((it) => it.querySelector('button')); // the plain Articles link has no dropdown button
  const closeAll = (except?: HTMLElement) => items.forEach((it) => { if (it !== except) { it.classList.remove('open'); it.querySelector('button')!.setAttribute('aria-expanded', 'false'); } });
  items.forEach((it) => {
    const b = it.querySelector('button')!;
    b.addEventListener('click', (e) => { e.stopPropagation(); const o = !it.classList.contains('open'); closeAll(it); it.classList.toggle('open', o); b.setAttribute('aria-expanded', String(o)); });
  });
  document.addEventListener('click', (e) => { if (!(e.target as Element).closest('.nav-item')) closeAll(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });
  const mb = document.querySelector<HTMLButtonElement>('.menu-btn')!; const nav = document.getElementById('nav')!;
  mb.addEventListener('click', () => { const o = nav.classList.toggle('open'); mb.setAttribute('aria-expanded', String(o)); });
</script>
