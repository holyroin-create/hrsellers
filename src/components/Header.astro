---
import { SITE } from '../config';
import { NAV } from '../data/nav';
import { POLICY, LATEST_IN_FORCE } from '../data/policy';
import Mark from './Mark.astro';

const path = Astro.url.pathname;
const active = (g: any) => g.href === path || g.children.some((c: any) => c.href === path);

const MARKETS = [
  { label: 'Amazon', href: '/marketplaces/amazon/' },
  { label: 'Walmart', href: '/marketplaces/walmart/' },
  { label: 'eBay', href: '/marketplaces/ebay/' },
  { label: 'TikTok Shop', href: '/marketplaces/tiktok-shop/' },
  { label: 'Etsy', href: '/marketplaces/etsy/' },
];

/* Ticker is rendered twice so the marquee loop has no visible seam. */
const ticker = POLICY.slice(0, 6);
---
<a class="skip" href="#main">Skip to content</a>

<div class="utility">
  <div class="wrap crow">
    <div class="marketplaces">
      <span class="tag"><span class="dot" aria-hidden="true"></span>Independent · {SITE.publisher}</span>
      {MARKETS.map(m => <a href={m.href}>{m.label}</a>)}
    </div>
    <div class="util-right">
      <a href="/how-we-test/">Scoring rubric</a>
      <a href="/corrections/">Corrections</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
</div>

<div class="masthead">
  <div class="wrap crow">
    <a class="brand" href="/">
      <Mark size={30} />
      <span class="bt"><span class="bn">FBA<i>Tactics</i></span><em>Marketplace seller operations</em></span>
    </a>

    <form class="search" action="/guides/" method="get" role="search">
      <label class="skip" for="q">Search guides</label>
      <input id="q" name="q" type="search" placeholder="Search fees, shipping, software…" autocomplete="off" />
      <button type="submit">Search</button>
    </form>

    <a class="feewatch" href="/policy-log/">
      <span class="fw-k">Fee watch</span>
      <span class="fw-t">{LATEST_IN_FORCE.short}</span>
      <span class="fw-d">In force since {LATEST_IN_FORCE.date}</span>
    </a>
  </div>
</div>

<nav class="navbar" aria-label="Sections">
  <div class="wrap crow">
    <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="nav">☰ Menu</button>
    <div class="nav" id="nav">
      {NAV.map(g => (
        <div class="navgroup">
          <a href={g.href} aria-current={active(g) ? 'page' : undefined} aria-haspopup="true">{g.label}<span class="chev" aria-hidden="true">▼</span></a>
          <div class="dropdown">
            {g.children.map(c => (
              <a href={c.href}><strong>{c.label}</strong><em>{c.note}</em></a>
            ))}
          </div>
        </div>
      ))}
    </div>
    <a class="nav-cta" href="/tools/">Free calculators</a>
  </div>
</nav>

<div class="ticker">
  <div class="wrap crow">
    <span class="tk-label"><span aria-hidden="true"></span>Policy log</span>
    <div class="tk-view">
      <div class="tk-track">
        {ticker.map(e => <a href="/policy-log/"><b>{e.date}</b>{e.short}</a>)}
        {ticker.map(e => <a href="/policy-log/" aria-hidden="true" tabindex="-1"><b>{e.date}</b>{e.short}</a>)}
      </div>
    </div>
  </div>
</div>

<script>
  const b = document.getElementById('menu-btn');
  const n = document.getElementById('nav');
  b?.addEventListener('click', () => {
    const open = n?.classList.toggle('open');
    b.setAttribute('aria-expanded', String(!!open));
  });
</script>
