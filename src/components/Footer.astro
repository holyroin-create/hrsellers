---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
const cols = [
  ['Fees', [['/marketplaces/amazon/', 'Amazon'], ['/marketplaces/walmart/', 'Walmart'], ['/marketplaces/ebay/', 'eBay'], ['/marketplaces/etsy/', 'Etsy'], ['/marketplaces/shopify/', 'Shopify']]],
  ['Importing', [['/guides/#importing', 'Import guides'], ['/guides/tariff-stack-2026/', 'How duties stack'], ['/policy-log/', 'Policy log'], ['/reference/key-dates/', 'Key dates'], ['/resources/', 'Primary sources']]],
  ['Use', [['/tools/', 'Calculators'], ['/checklists/', 'Checklists'], ['/quiz/', 'Knowledge check'], ['/faq/', 'Seller FAQ'], ['/glossary/', 'Glossary']]],
  ['Site', [['/about/', 'About'], ['/editorial-standards/', 'How we check facts'], ['/corrections/', 'Corrections'], ['/contact/', 'Contact'], ['/privacy/', 'Privacy'], ['/cookie-policy/', 'Cookies'], ['/terms/', 'Terms'], ['/disclaimer/', 'Disclaimer'], ['/image-credits/', 'Image credits'], ['/sitemap/', 'Site map']]],
] as const;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <Logo light />
        <p>Marketplace fees, US import duties and seller compliance rules — explained in plain English and checked against the official source, with the date each figure was confirmed.</p>
        <p><a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      </div>
      {cols.map(([h, links]) => <div><h2>{h}</h2><ul>{links.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul></div>)}
    </div>
    <div class="foot-legal">
      <p>FBA Tactics is independent. It is not affiliated with or endorsed by Amazon, Walmart, eBay, Etsy, Shopify or any government agency; their names identify whose fees or rules are described. General information, not legal or tax advice.</p>
      <p>© {new Date().getFullYear()} {SITE.publisherName}</p>
    </div>
  </div>
</footer>
