---
import { SITE, AUTHOR } from '../config';

const TAGS = [
  { label: 'FBA fees', href: '/guides/' },
  { label: 'De minimis', href: '/guides/' },
  { label: 'Reimbursements', href: '/guides/' },
  { label: 'Dimensional weight', href: '/tools/dimensional-weight/' },
  { label: 'Break-even ACOS', href: '/tools/margin-calculator/' },
  { label: 'Cash flow', href: '/tools/cash-flow-planner/' },
  { label: 'Walmart WFS', href: '/marketplaces/' },
  { label: 'Startup costs', href: '/costs/' },
];
---
<footer class="site-foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <p class="bn">FBA<i>Tactics</i></p>
        <p class="org">
          Published by <strong>{SITE.publisher}</strong><br />
          Editor: <strong>{AUTHOR.name}</strong><br />
          <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
        </p>
      </div>
      <div>
        <h4>Learn</h4>
        <a href="/start-here/">Start here</a>
        <a href="/guides/">Guides</a>
        <a href="/business-models/">Business models</a>
        <a href="/costs/">What it costs</a>
        <a href="/reality-check/">Reality check</a>
      </div>
      <div>
        <h4>Reference</h4>
        <a href="/quiz/">Model fit check</a>
        <a href="/resources/">Free templates</a>
        <a href="/glossary/">Glossary</a>
        <a href="/policy-log/">Fee and policy log</a>
        <a href="/marketplaces/">Marketplaces</a>
        <a href="/reviews/">Tool reviews</a>
      </div>
      <div>
        <h4>Company</h4>
        <a href="/about/">About</a>
        <a href="/how-we-test/">How we test</a>
        <a href="/editorial-standards/">Editorial standards</a>
        <a href="/corrections/">Corrections</a>
        <a href="/contact/">Contact</a>
        <a href="/privacy/">Privacy policy</a>
        <a href="/cookie-policy/">Cookie policy</a>
        <a href="/terms/">Terms of use</a>
        <a href="/affiliate-disclosure/">Affiliate disclosure</a>
      </div>
    </div>

    <div class="tagstrip">
      <span class="tl">Popular topics</span>
      {TAGS.map(t => <a href={t.href}>{t.label}</a>)}
    </div>

    <p class="legal">
      Every figure published here carries the date it was checked and a link to its source. Rates change
      on the platforms' own timetable — verify anything material against the marketplace's own
      documentation before acting on it. Nothing here is tax, legal or financial advice. This site is
      independent and is not affiliated with, endorsed by, or sponsored by Amazon, Walmart, eBay, Shopify,
      Etsy or TikTok. Funded by display advertising; advertisers have no influence on editorial.
      &copy; {new Date().getFullYear()} {SITE.publisher}.
    </p>
  </div>
</footer>
