        <p>Published by {SITE.publisherName}. <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>
      </div>
      <div><h2>Read</h2><ul>
        <li><a href="/guides/">All guides</a></li><li><a href="/marketplaces/">Fee reference</a></li>
        <li><a href="/policy-log/">Policy log</a></li><li><a href="/glossary/">Glossary</a></li><li><a href="/resources/">Primary sources</a></li>
      </ul></div>
      <div><h2>Use</h2><ul>
        <li><a href="/tools/">Calculators</a></li><li><a href="/quiz/">Knowledge check</a></li><li><a href="/start-here/">Start here</a></li><li><a href="/sitemap/">Site map</a></li>
