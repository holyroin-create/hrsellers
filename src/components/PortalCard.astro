---
import Cover from './Cover.astro';
const { href, slug = '', category, title, summary, minutes, published, modified, ledger, ledgerKind = 'recovered' } = Astro.props;

const BADGE: Record<string, string> = {
  'Fees & reimbursements': 'fees',
  'Shipping & logistics': 'ship',
  'Software': 'soft',
  'Getting started': 'start',
  'Scaling': 'scale',
};
const SHORT: Record<string, string> = {
  'Fees & reimbursements': 'Fees',
  'Shipping & logistics': 'Shipping',
  'Software': 'Software',
  'Getting started': 'Getting started',
  'Scaling': 'Scaling',
};

/* Absolute publication date. A static build cannot honestly say "Today":
   the string is frozen at build time, and it was reading `modified`, so a
   site-wide source re-verification made every card claim it was new.
   The review date belongs on the article page, next to the sources. */
const fmt = (s: string) => {
  const d = new Date(s);
  return Number.isNaN(d.getTime()) ? s : d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
};
const stamp = published;
---
<a class="pcard" href={href}>
  <div class="pthumb">
    <Cover slug={slug} category={category} />
    {minutes && <span class="dur">{minutes} min</span>}
  </div>
  <div>
    <p class="pmeta">
      <span class={`badge ${BADGE[category] ?? 'start'}`}>{SHORT[category] ?? category}</span>
      <span class="ago">{fmt(stamp)}</span>
    </p>
    <h3>{title}</h3>
    <p>{summary}</p>
    {ledger && <span class={ledgerKind === 'cost' ? 'ledger cost' : 'ledger'}><b>{ledger}</b></span>}
  </div>
</a>
