---
import Icon from './Icon.astro';
const { type = 'note', title = '' } = Astro.props as { type?: 'tip' | 'note' | 'warning' | 'example'; title?: string };
const ic = { tip: 'bulb', note: 'info', warning: 'alert', example: 'calculator' }[type];
const def = { tip: 'Tip', note: 'Note', warning: 'Watch out', example: 'Worked example' }[type];
---
<aside class={`callout callout-${type}`}><Icon name={ic} /><div><p class="callout-title">{title || def}</p><slot /></div></aside>
