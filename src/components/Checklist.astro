---
import Icon from './Icon.astro';
const { title, items = [] } = Astro.props as { title: string; items: string[] };
const id = 'cl-' + title.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);
---
<figure class="fig checklist" id={id}><figcaption class="fig-title"><Icon name="checkCircle" />{title}</figcaption>
  <ul>{items.map((t, i) => <li><input type="checkbox" id={`${id}-${i}`} /><label for={`${id}-${i}`}>{t}</label></li>)}</ul>
  <div class="foot"><button class="btn btn-ghost btn-sm" type="button" onclick="window.print()"><Icon name="printer" />Print</button><span>Ticks stay in this page only.</span></div>
</figure>
