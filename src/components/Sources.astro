---
import { claim, fmtDate, hostOf, sourceGroups } from '../lib/claims';
const order: string[] = [...new Set(((Astro.locals as any).citeOrder || []) as string[])];
order.forEach((id) => claim(id));
const groups = sourceGroups(order);
---
{groups.length > 0 && (
<section class="sources" aria-labelledby="src-h">
  <h2 id="src-h">Sources</h2>
  <p>Each source is the agency, regulation or platform page that sets the rule or fee. It was opened and compared with the statements it supports on the date shown.</p>
  <ol>{groups.map((g) => (
    <li><div>
      {g.ids.map((id) => <span class="anchor" id={`src-${id}`}></span>)}
      <a class="src" href={g.url} rel="noopener">{g.c.publisher}</a>
      <span class="src-meta">{hostOf(g.url)} · {g.c.source_type.replace(/-/g, ' ')} · checked {fmtDate(g.c.accessed)}</span>
      <details><summary>Supports {g.ids.length} statement{g.ids.length > 1 ? 's' : ''} on this page</summary><ul>{g.ids.map((id) => <li>{claim(id).claim}</li>)}</ul></details>
    </div></li>))}
  </ol>
</section>)}
