---
import { claim, fmtDate, hostOf, sourceGroups } from '../lib/claims';
const order: string[] = (Astro.locals as any).citeOrder || [];
order.forEach((id) => claim(id));
const groups = sourceGroups(order);
---
{groups.length > 0 && (
<section class="sources" aria-labelledby="src-h">
  <h2 id="src-h">Sources</h2>
  <p class="meta">Each source is the body that issues the rule or fee, and was opened and compared with the statements it supports on the date shown.</p>
  <ol>
    {groups.map((g) => (
      <li>
        {g.ids.map((id) => <span id={`src-${id}`} class="anchor"></span>)}
        <a href={g.url} rel="noopener">{g.c.publisher}</a>
        <span class="src-meta">{hostOf(g.url)} · {g.c.source_type.replace(/-/g, ' ')} · checked {fmtDate(g.c.accessed)}</span>
        {g.ids.length > 1
          ? <details><summary>Supports {g.ids.length} statements on this page</summary><ul>{g.ids.map((id) => <li>{claim(id).claim}</li>)}</ul></details>
          : <span class="src-claim">{claim(g.ids[0]).claim}</span>}
      </li>
    ))}
  </ol>
</section>
)}
