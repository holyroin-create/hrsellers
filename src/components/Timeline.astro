---
import Icon from './Icon.astro';
import Cites from './Cites.astro';
import { fmtDate } from '../lib/claims';
const { title, items = [] } = Astro.props as { title: string; items: { date: string; t: string; d?: string; claim?: string }[] };
const nice = (d: string) => (/^\d{4}-\d{2}-\d{2}$/.test(d) ? fmtDate(d, true) : d);
---
<figure class="fig"><figcaption class="fig-title"><Icon name="calendar" />{title}</figcaption>
  <ol class="tl">{items.map((i) => <li><time datetime={i.date}>{nice(i.date)}</time><span class="dot"></span><div><b>{i.t}{i.claim && <Cites ids={[i.claim]} />}</b>{i.d && <span>{i.d}</span>}</div></li>)}</ol>
</figure>
