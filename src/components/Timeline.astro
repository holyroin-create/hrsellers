---
import { fmtDate , citeNum } from '../lib/claims';
const { title, items = [] } = Astro.props as { title: string; items: { date: string; t: string; d?: string; claim?: string }[] };
const order: string[] = (Astro.locals as any).citeOrder || [];
const nice = (d: string) => (/^\d{4}-\d{2}-\d{2}$/.test(d) ? fmtDate(d) : d);
---
<figure class="figure">
  <figcaption class="figure-title">{title}</figcaption>
  <ol class="timeline">{items.map((i) => (
    <li><time datetime={i.date}>{nice(i.date)}</time><b>{i.t}</b>{i.d && <span>{i.d}</span>}
      {i.claim && <sup class="cite"><a href={`#src-${i.claim}`}>[{citeNum(order, i.claim)}]</a></sup>}</li>
  ))}</ol>
</figure>
