---
/** Numbered horizontal flow / timeline. steps: [{ t, d }], accent index optional. */
const { title = '', steps = [], accent = -1, source = '' } = Astro.props;
const n = steps.length; const W = 640; const H = 148;
const x0 = 40, x1 = W - 40; const dx = n > 1 ? (x1 - x0) / (n - 1) : 0;
---
<figure class="figpanel diagram" style="margin:1.8rem 0 2rem">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg" style="width:100%;height:auto;display:block">
    {title && <text x="24" y="24" style="font:700 13px/1 'Barlow', system-ui;letter-spacing:.14em;fill:#5a606a">{title.toUpperCase()}</text>}
    <line x1={x0} y1="66" x2={x1} y2="66" stroke="#d2d6dc" stroke-width="2" />
    {steps.map((s, i) => (
      <g>
        <circle cx={x0 + dx * i} cy="66" r="15" fill={i === accent ? '#e06e14' : '#20242b'} />
        <text x={x0 + dx * i} y="71" text-anchor="middle" style="font:800 13px 'Barlow', system-ui;fill:#fff">{i + 1}</text>
        <text x={x0 + dx * i} y="102" text-anchor="middle" style="font:700 12.5px 'Barlow', system-ui;fill:#14171b">{s.t}</text>
        <text x={x0 + dx * i} y="118" text-anchor="middle" style="font:400 11px 'Barlow', system-ui;fill:#5a606a">{s.d}</text>
      </g>
    ))}
  </svg>
  {source && <figcaption class="cap">{source}</figcaption>}
</figure>
