---
import Base from '../layouts/Base.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import AdSlot from './AdSlot.astro';
import AuthorBox from './AuthorBox.astro';
const { title, description, eyebrow, h1, lede, crumb, rail = [] } = Astro.props;
---
<Base title={title} description={description}>
<div class="wrap"><Breadcrumbs trail={[{ label: crumb.label, href: crumb.href }]} /></div>
<div class="wrap">
  <div class="article-grid">
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1 style="max-width:22ch">{h1}</h1>
      <p style="max-width:44ch;font-size:1.15rem;color:var(--ink-soft);margin:1.2rem 0 1.6rem">{lede}</p>
      <AdSlot inline={true} label="ad slot — below intro" />
      <slot />
      <AdSlot label="ad slot — end of page" />
      <AuthorBox />
      <slot name="sources" />
    </div>
    <aside class="rail">
      {rail.length > 0 && (
        <div class="rail-box">
          <h4>Read next</h4>
          <ul class="toc">{rail.map((r: any) => <li><a href={r.href}>{r.label}</a></li>)}</ul>
        </div>
      )}
      <AdSlot label="ad slot — sidebar" />
    </aside>
  </div>
</div>
</Base>
