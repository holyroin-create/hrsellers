---
import Page from '../layouts/Page.astro';
import Cites from '../components/Cites.astro';
import Icon from '../components/Icon.astro';
import { policyLog } from '../lib/data';
import { fmtDate } from '../lib/claims';
const log = policyLog();
const cites = [...new Set(log.flatMap((e) => e.claim_ids))];
---
<Page title="Policy log: rule and fee changes for sellers" description="A dated log of official US government notices and marketplace fee changes that affect importers and online sellers, each linked to the original document." kicker="Updates" photo="hub-policy" lede="Every entry links to the notice the agency or platform published. The summary is ours; the notice is the authority." cites={cites} wide>
  <p><a class="chip" href="/rss.xml"><Icon name="rss" />Follow by RSS</a></p>
  {log.map((e) => (
    <article id={e.id} class="card" style="padding:22px 24px;margin:16px 0;scroll-margin-top:96px">
      <p class="muted" style="font-size:.86rem;margin:0 0 6px"><time datetime={e.date}>{fmtDate(e.date)}</time> · {e.agency}{e.effective && <> · effective {/^\d{4}-\d{2}-\d{2}$/.test(e.effective) ? fmtDate(e.effective) : e.effective}</>}</p>
      <h2 style="font-size:1.2rem;margin:0 0 8px">{e.title}</h2>
      <p style="margin:0 0 10px">{e.summary} <Cites ids={e.claim_ids} /></p>
      <a class="link-arrow" href={e.url} rel="noopener">Read the official notice<Icon name="arrow" /></a>
    </article>))}
  {log.length === 0 && <p>Entries are being verified.</p>}
</Page>
