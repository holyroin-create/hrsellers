---
import Page from '../layouts/Page.astro';
import { policyLog } from '../lib/data';
import { fmtDate } from '../lib/claims';
import Cites from '../components/Cites.astro';
const log = policyLog();
---
<Page title="Policy log" eyebrow="Official notices" description="A dated log of official US government notices and platform fee changes that affect importers and marketplace sellers, each linked to the original document." lede="Each entry links to the original notice published by the agency or platform. Summaries are ours; the notice is the authority." cites={[...new Set(log.flatMap((e) => e.claim_ids))]}>
  {log.length === 0 && <p>No verified entries yet.</p>}
  {log.map((e) => (
    <article id={e.id} style="border-top:1px solid var(--rule);padding:1rem 0;scroll-margin-top:1rem">
      <p class="meta"><time datetime={e.date}>{fmtDate(e.date)}</time> · {e.agency}{e.effective && <> · effective {/^\d{4}-\d{2}-\d{2}$/.test(e.effective) ? fmtDate(e.effective) : e.effective}</>}</p>
      <h2 style="margin:.3rem 0 .5rem;font-size:1.25rem">{e.title}</h2>
      <p>{e.summary} <Cites ids={e.claim_ids} /></p>
      <p><a href={e.url} rel="noopener">Read the official notice</a></p>
    </article>
  ))}
</Page>
