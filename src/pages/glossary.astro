---
import Page from '../layouts/Page.astro';
import Cites from '../components/Cites.astro';
import { glossary } from '../lib/data';
const terms = glossary().sort((a: any, b: any) => a.term.localeCompare(b.term));
const cites = [...new Set(terms.flatMap((t: any) => t.claim_ids))];
const ld = [{ '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'FBA Tactics glossary', hasDefinedTerm: terms.map((t: any) => ({ '@type': 'DefinedTerm', name: t.term, description: t.definition })) }];
const letters = [...new Set(terms.map((t: any) => t.term[0].toUpperCase()))];
---
<Page title="Glossary of import and marketplace fee terms" description="Plain-English definitions of customs, import and marketplace fee terms, each tied to the regulation or platform page that defines it and linked to the guide." kicker="Reference" photo="hub-reference" lede="Terms as the regulations and platforms use them, in plain English, each linked to its source and to the guide that covers it." cites={cites} jsonld={ld} trail={[{ label: 'Reference', href: '/reference/' }]}>
  <p style="display:flex;flex-wrap:wrap;gap:6px">{letters.map((l) => <a class="chip" href={`#l-${l}`}>{l}</a>)}</p>
  {letters.map((l) => <section id={`l-${l}`} style="scroll-margin-top:96px"><h2>{l}</h2><dl>{terms.filter((t: any) => t.term[0].toUpperCase() === l).map((t: any) => <><dt style="font-weight:700;color:var(--ink);margin-top:18px">{t.term}</dt><dd style="margin:4px 0 0">{t.definition} <Cites ids={t.claim_ids} />{t.guide && <> <a href={t.guide}>Guide →</a></>}</dd></>)}</dl></section>)}
</Page>
