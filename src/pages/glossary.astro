---
import Page from '../layouts/Page.astro';
import fs from 'node:fs';
import { allClaims } from '../lib/claims';
import Cites from '../components/Cites.astro';
const claims = allClaims();
const terms = (fs.existsSync('data/glossary.json') ? JSON.parse(fs.readFileSync('data/glossary.json', 'utf8')) : [])
  .filter((t: any) => t.claim_ids.every((id: string) => claims.get(id)?.status === 'verified')).sort((a: any, b: any) => a.term.localeCompare(b.term));
const cites = [...new Set(terms.flatMap((t: any) => t.claim_ids))] as string[];
const ld = [{ '@context': 'https://schema.org', '@type': 'DefinedTermSet', name: 'FBA Tactics glossary', hasDefinedTerm: terms.map((t: any) => ({ '@type': 'DefinedTerm', name: t.term, description: t.definition })) }];
---
<Page title="Glossary" eyebrow="Reference" description="Import, customs and marketplace fee terms explained in plain English, each tied to the regulation or platform page that defines it." lede="Terms as the regulations and platforms use them, in plain English. Each entry links to the source that defines it and to the guide that covers it." cites={cites} jsonld={ld}>
  <dl>{terms.map((t: any) => (
    <><dt id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, '-')} style="font-weight:600;margin-top:1.2rem">{t.term}</dt>
    <dd style="margin:.3rem 0 0">{t.definition} <Cites ids={t.claim_ids} />{t.guide && <> · <a href={t.guide}>Guide</a></>}</dd></>
  ))}</dl>
</Page>
