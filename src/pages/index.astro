---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { policyLog, rateboard, CATS } from '../lib/data';
import { fmtDate, allClaims } from '../lib/claims';
import { SITE } from '../lib/site';
const guides = (await getCollection('guides', (e) => !e.data.draft)).sort((a, b) => b.data.modified.localeCompare(a.data.modified) || a.data.title.localeCompare(b.data.title));
const markets = await getCollection('marketplaces', (e) => !e.data.draft);
const log = policyLog().slice(0, 6);
const rates = rateboard();
const claims = allClaims();
const ld = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.siteName, url: SITE.domain }];
const verifiedCount = [...claims.values()].filter((c) => c.status === 'verified').length;
---
<Base title="Marketplace fees and US import rules, from the primary source" description="Fee schedules for Amazon, Walmart, eBay, Etsy and Shopify, and the US customs rules importers must follow — each figure linked to the regulation or platform page it comes from." jsonld={ld}>
  <section class="home-top"><div class="wrap home-grid">
    <div>
      <p class="eyebrow">For sellers who import and sell on marketplaces</p>
      <h1>Know the fee and the rule before the invoice does.</h1>
      <p class="lede">Platform fee schedules and US import regulations, explained in plain English and worked through with arithmetic. Every figure links to the regulation, Federal Register notice or platform page it comes from, and shows the day it was last checked.</p>
      <div class="home-actions">
        <a class="btn btn-tag" href="/start-here/">Start here →</a>
        <a class="btn" href="/quiz/">Test what you know — 12 questions</a>
      </div>
      <p class="meta">{guides.length + markets.length} reference pages · {verifiedCount} individually sourced facts · no sponsored content</p>
    </div>
    <section class="ledger" aria-labelledby="log-h">
      <div class="ledger-head"><h2 id="log-h">Policy log</h2><span class="meta">official notices only</span></div>
      {log.length ? <ol>{log.map((e) => (
        <li><time datetime={e.date}>{fmtDate(e.date).replace(/, \d{4}$/, '')}<span class="agency">{e.agency}</span></time>
          <div><a href={`/policy-log/#${e.id}`}>{e.title}</a></div></li>
      ))}</ol> : <p style="padding:1rem 1.5rem">The log is being rebuilt from official notices.</p>}
      <div class="ledger-foot"><a class="btn btn-tag" href="/policy-log/" style="width:100%;justify-content:center">Open the full log →</a></div>
    </section>
  </div></section>

  <div class="wrap">
    {rates.length > 0 && (
    <section class="rateboard" aria-labelledby="rb-h">
      <h2 id="rb-h">Figures sellers ask about most</h2>
      <table class="data"><thead><tr><th>Figure</th><th>Current value</th><th>Source, checked</th></tr></thead>
        <tbody>{rates.map((r) => { const c = claims.get(r.claim_id)!; return (
          <tr><td><a href={r.href}>{r.label}</a></td><td><strong>{r.value}</strong></td><td class="meta"><a href={c.source_url} rel="noopener">{c.publisher}</a>, {fmtDate(c.accessed)}</td></tr>); })}</tbody></table>
    </section>)}

    <div class="sections">
      {CATS.map((cat) => { const list = [...guides.filter((g) => g.data.category === cat.name).map((g) => ({ href: `/guides/${g.id}/`, t: g.data.title, d: g.data.description })), ...(cat.name === 'Marketplace fees' ? markets.map((m) => ({ href: `/marketplaces/${m.id}/`, t: m.data.title, d: m.data.description })) : [])];
        return list.length ? (
        <section class="section-list" aria-labelledby={`h-${cat.id}`}>
          <h2 id={`h-${cat.id}`}><a href={`/guides/#${cat.id}`} style="color:inherit;text-decoration:none">{cat.name}</a></h2>
          <p class="meta">{cat.d}</p>
          <ol>{list.slice(0, 6).map((g) => <li><div><a href={g.href}>{g.t}</a></div></li>)}</ol>
        </section>) : null; })}
    </div>
  </div>

  <section class="toolstrip"><div class="wrap">
    <h2>Calculators that show their working</h2>
    <p>Run in your browser. Nothing you type is sent or stored.</p>
    <div class="tools-row">
      <a href="/tools/margin-calculator/"><b>Margin</b><span>Net per unit after platform fees</span></a>
      <a href="/tools/tariff-stack-estimator/"><b>Duty &amp; fees</b><span>Duty, MPF and HMF on one entry</span></a>
      <a href="/tools/dimensional-weight/"><b>Dimensional weight</b><span>Which weight you are billed on</span></a>
      <a href="/tools/cash-flow-planner/"><b>Cash flow</b><span>When stock money comes back</span></a>
      <a href="/tools/ppc-budget-calculator/"><b>Ad budget</b><span>Spend, ACoS, break-even</span></a>
    </div>
  </div></section>
</Base>
