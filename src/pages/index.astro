---
import Base from '../layouts/Base.astro';
import Newsletter from '../components/Newsletter.astro';
import Btn from '../components/Btn.astro';
import AdSlot from '../components/AdSlot.astro';
import AuthorBox from '../components/AuthorBox.astro';
import PortalCard from '../components/PortalCard.astro';
import Cover from '../components/Cover.astro';
import { SITE } from '../config';
import { POLICY } from '../data/policy';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides', ({ data }) => !data.draft))
  .sort((a, b) => +new Date(b.data.published) - +new Date(a.data.published));
const lead = guides[0];
/* Homepage shows the latest 10 (1 lead + 9 cards). The full archive lives at
   /guides/ — rendering all 50+ cards here buried the policy log and every
   section below the fold. */
const rest = guides.slice(1, 10);
const total = guides.length;

const covers = ['Amazon FBA', 'Walmart WFS', 'eBay', 'TikTok Shop', 'Etsy', 'Third-party fulfillment'];

const mostRead = [
  { href: '/costs/', label: 'What it actually costs to start selling' },
  { href: '/tools/margin-calculator/', label: 'Margin and break-even ACOS calculator' },
  { href: '/policy-log/', label: 'Fee and policy change log' },
  { href: '/reality-check/', label: 'What nobody puts in the sales video' },
  { href: '/glossary/', label: 'Seller glossary, 26 terms' },
];
---
<Base ogImage={"/og/p-home.png"} title={SITE.name} description={SITE.description}>

<div class="band-dark">
  <section class="wrap" style="padding:2.6rem 1.25rem 2.8rem">
    <div class="hero-split">
      <div>
        <p class="eyebrow">Operator-written · every figure sourced</p>
        <h1 style="max-width:15ch;font-size:clamp(2.2rem,5vw,3.4rem)">Marketplace selling, read from the invoice up.</h1>
        <p style="max-width:46ch;font-size:1.05rem;margin:1.1rem 0 1.6rem">{SITE.description}</p>
        <div class="btn-row">
          <Btn href="/quiz/">Find your model — 15 questions</Btn>
          <Btn href="/tools/" variant="cta">Open the free calculators</Btn>
          <Btn href="/start-here/" quiet={true}>Start here</Btn>
        </div>
        <div class="pill-row">{covers.map(c => <span class="pill">{c}</span>)}</div>
      </div>
      <div class="figpanel">
          <Cover slug="policy-timeline" category="Fees & reimbursements" wide={true} />
          <p class="cap">Every fee and tariff change since May 2025, dated and sourced. <a href="/policy-log/" style="color:inherit">Open the log →</a></p>
        </div>
    </div>
  </section>
</div>

<div class="wrap">
  <div class="portal">

    <div>
      <div class="sechead green">
        <h2>Latest</h2>
        <a class="more" href="/guides/">All guides →</a>
      </div>

      {lead && (
        <a class="plead" href={`/guides/${lead.id}/`}>
          <div class="cover"><Cover slug={lead.id} category={lead.data.category} wide={true} /></div>
          <div class="body">
            <p class="pmeta">
              <span class="badge fees">{lead.data.category}</span>
              <span class="ago">{lead.data.minutes} min read</span>
            </p>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.description}</p>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <div class="plist">
          {rest.map(g => (
            <PortalCard
              href={`/guides/${g.id}/`}
              slug={g.id}
              category={g.data.category}
              title={g.data.title}
              summary={g.data.description}
              minutes={g.data.minutes}
              published={g.data.published}
              modified={g.data.modified}
              ledger={g.data.ledger}
              ledgerKind={g.data.ledgerKind}
            />
          ))}
        </div>
      )}

      <div style="display:flex;justify-content:center;margin:1.4rem 0 .4rem">
        <Btn href="/guides/" variant="dark">Browse all {total} guides</Btn>
      </div>

      <AdSlot label="homepage — below the latest list" />

      <div class="sechead">
        <h2>Start here</h2>
      </div>
      <div class="grid">
        <a class="card hubcard" href="/quiz/">
          <div class="body">
            <span class="meta">15 questions · no email</span>
            <h3>Which selling model fits you</h3>
            <p>Capital, contacts, time and downside tolerance decide this far more than enthusiasm does. Scored in your browser, nothing stored.</p>
          </div>
        </a>
        <a class="card hubcard" href="/costs/">
          <div class="body">
            <span class="meta">Reference</span>
            <h3>What it actually costs to start</h3>
            <p>Published ranges by model, with the disagreements left visible. Private label estimates vary by a factor of ten, and the reason is worth knowing.</p>
          </div>
        </a>
        <a class="card hubcard" href="/reality-check/">
          <div class="body">
            <span class="meta">Reality check</span>
            <h3>What nobody puts in the sales video</h3>
            <p>Cash flow timing, the rising fee floor, account risk — and why so many paid courses transfer money rather than skill.</p>
          </div>
        </a>
        <a class="card hubcard" href="/business-models/">
          <div class="body">
            <span class="meta">Comparison</span>
            <h3>The five models, and what each rules out</h3>
            <p>Retail arbitrage, online arbitrage, wholesale, private label, handmade. Each closes doors as well as opening them.</p>
          </div>
        </a>
      </div>

      <div class="sechead orange" style="margin-top:2.4rem">
        <h2>Fee and policy log</h2>
        <a class="more" href="/policy-log/">Full log →</a>
      </div>
      <div class="plist" style="padding:.3rem 1.1rem">
        {POLICY.slice(0, 4).map(e => (
          <div class="logentry" style="padding-bottom:1.1rem;margin-top:.9rem">
            <p class="logdate">{e.date} <span class={e.status === 'Upcoming' ? 'logstat up' : 'logstat'}>{e.status}</span></p>
            <h3 style="margin:.3rem 0 .35rem">{e.title}</h3>
            <p style="font-family:var(--ui);font-size:.87rem;color:var(--ink-soft);margin:0">{e.what}</p>
          </div>
        ))}
      </div>
    </div>

    <aside class="rail">
      <div class="rail-box orange">
        <h4>Free calculators</h4>
        <p>Margin and break-even ACOS, cash flow timing, and billable dimensional weight. They run in your browser and store nothing.</p>
        <Btn href="/tools/" variant="cta" wide={true} arrow={false}>Open the tools</Btn>
      </div>

      <div class="rail-box">
        <h4>Most read</h4>
        <ol class="ranked">
          {mostRead.map(m => <li><a href={m.href}>{m.label}</a></li>)}
        </ol>
      </div>

      <div class="rail-box">
        <h4>How this site works</h4>
        <div class="rail-links">
          <a href="/how-we-test/">The scoring rubric</a>
          <a href="/editorial-standards/">Editorial standards</a>
          <a href="/corrections/">Corrections log</a>
          <a href="/about/">Who writes this</a>
        </div>
      </div>

      <AdSlot label="homepage rail" />
    </aside>

  </div>
</div>

<div class="band-dark" style="margin-top:2.8rem">
  <section class="wrap" style="padding:3rem 1.25rem">
    <div class="hero-split">
      <div>
        <p class="eyebrow">Method</p>
        <h2 style="max-width:20ch;margin-bottom:1rem">Every figure carries either a period or a source.</h2>
        <p style="max-width:46rem">
          Every rate here is linked to its source and stamped with the day it was checked. Where two
          published sources disagree — and on marketplace fees they routinely do — both figures appear
          and the reader is sent to the primary document, rather than one being quietly picked. Where a
          figure comes from operations the author worked on directly, it is labeled first-party and the
          period is stated.
        </p>
        <div class="btn-row" style="margin-top:1.4rem">
          <Btn href="/how-we-test/">Read the rubric</Btn>
          <Btn href="/editorial-standards/" quiet={true}>Editorial standards</Btn>
        </div>
      </div>
      <div class="figpanel">
          <Cover slug="method-ledger" category="Shipping & logistics" wide={true} />
          <p class="cap">The two routes a number can take onto this site. There is no third. <a href="/editorial-standards/" style="color:inherit">Editorial standards →</a></p>
        </div>
    </div>
  </section>

<div class="wrap"><Newsletter /></div>
</div>

<div class="wrap"><AuthorBox /></div>

</Base>
