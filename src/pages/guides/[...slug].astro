---
import Base from '../../layouts/Base.astro';
import AdSlot from '../../components/AdSlot.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import Newsletter from '../../components/Newsletter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Cover from '../../components/Cover.astro';
import { AUTHOR } from '../../config';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const guides = await getCollection('guides', ({ data }) => !data.draft);
  return guides.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

/* Related guides: same category first, then the rest of the catalogue by
   recency. Three cards, never the current page. A reader who reaches the foot
   of an article and finds nothing there leaves the site — this is the cheapest
   place to keep them reading. */
const all = (await getCollection('guides', ({ data }) => !data.draft)).filter(g => g.id !== entry.id);
const sameCat = all.filter(g => g.data.category === d.category);
const rest = all.filter(g => g.data.category !== d.category)
  .sort((a, b) => new Date(b.data.published).getTime() - new Date(a.data.published).getTime());
const related = [...sameCat, ...rest].slice(0, 3);
const toc = headings.filter(h => h.depth === 2).map(h => {
  const m = h.text.match(/^(\d{2})\s*(.*)$/);
  return { slug: h.slug, num: m ? m[1] : null, text: m ? m[2] : h.text };
});
const fmt = (s) => new Date(s).toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} seoTitle={d.seoTitle} description={d.description} type="Article" published={d.published} modified={d.modified} ogImage={`/og/g-${entry.id}.png`}>
<div class="wrap">
  <Breadcrumbs trail={[{ label: 'Guides', href: '/guides/' }, { label: d.category, href: '/guides/' }]} />

  <div class="article-grid">
    <article>
      <p class="eyebrow" style="margin-bottom:.7rem">{d.category}{d.news && <span style="margin-left:.6rem;background:#e06e14;color:#fff;padding:.15rem .5rem;border-radius:6px;font-size:.72rem;letter-spacing:.08em">NEWS</span>}</p>
      <h1 style="max-width:22ch">{d.title}</h1>
      <p style="max-width:44ch;font-size:1.12rem;color:var(--ink-soft);margin:1.1rem 0 1.5rem">{d.description}</p>

      <div class="byline">
        <span class="av" aria-hidden="true">{AUTHOR.initials}</span>
        <span>By <a href="/about/">{AUTHOR.name}</a> &middot; {d.minutes} min read</span>
        <span class="reviewed">Reviewed {fmt(d.modified ?? d.published)}</span>
      </div>

      <figure class="figpanel" style="margin:0 0 2.2rem">
        <Cover slug={entry.id} category={d.category} wide={true} />
        <figcaption class="cap">The figure this guide is about, drawn from the sources listed at the foot of the page.</figcaption>
      </figure>

      {toc.length >= 3 && (
        <nav class="routemap" aria-label="The route through this guide">
          <span class="rm-k">THE ROUTE</span>
          {toc.map((h, i) => <a href={`#${h.slug}`}><i>{h.num ?? String(i + 1).padStart(2, '0')}</i>{h.text}</a>)}
        </nav>
      )}

      {d.ledger && <p style="margin:0 0 1.6rem"><span class={d.ledgerKind === 'cost' ? 'ledger cost' : 'ledger'}><b>{d.ledger}</b></span></p>}

      <AdSlot inline={true} label="ad slot — below intro" />

      <div class="prose"><Content /></div>

      <p class="disclosure">
        Published {fmt(d.published)}{d.modified && <> &middot; last reviewed {fmt(d.modified)}</>}.
        Marketplace fees and software pricing change often — verify anything material against the
        marketplace's own documentation before acting on it. Corrections: <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
      </p>

      {related.length > 0 && (
        <section class="nextread">
          <h2>Read next</h2>
          <a class="next-cta" href={`/guides/${related[0].id}/`}>
            <span>NEXT STEP</span>
            <strong>{related[0].data.title}</strong>
            <em>Continue →</em>
          </a>
          <div class="nextread-grid">
            {related.map(g => (
              <a class="nextread-card" href={`/guides/${g.id}/`}>
                <span class="nr-cat">{g.data.category}</span>
                <span class="nr-title">{g.data.title}</span>
                {g.data.ledger && <span class="nr-ledger">{g.data.ledger}</span>}
                <span class="nr-min">{g.data.minutes} min read</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <Newsletter compact={true} />

      <AdSlot label="ad slot — end of article" />
      <AuthorBox />
    </article>

    <aside class="rail">
      {toc.length > 0 && (
        <div class="rail-box">
          <h4>In this guide</h4>
          <ul class="toc">
            {toc.map(h => <li><a href={`#${h.slug}`}>{h.num && <i>{h.num}</i>}{h.text}</a></li>)}
          </ul>
        </div>
      )}
      <div class="rail-box">
        <h4>Article facts</h4>
        <dl class="factbox">
          <dt>Author</dt><dd>{AUTHOR.name}</dd>
          <dt>Category</dt><dd>{d.category}</dd>
          <dt>Last reviewed</dt><dd>{fmt(d.modified ?? d.published)}</dd>
          <dt>Method</dt><dd><a href="/how-we-test/" style="color:var(--recovered)">How we test</a></dd>
        </dl>
      </div>
      <AdSlot label="ad slot — sidebar" />
    </aside>
  </div>
</div>
<style>
  .routemap { display:flex; flex-wrap:wrap; gap:.45rem; align-items:center; margin:0 0 1.8rem; padding:.8rem .9rem; border:1px solid var(--rule,#d2d6dc); border-radius:10px; background:#fff; }
  .routemap .rm-k { font:700 .68rem/1 'Barlow',system-ui; letter-spacing:.14em; color:#e06e14; margin-right:.3rem; }
  .routemap a { display:inline-flex; align-items:center; gap:.35rem; font:600 .8rem/1 'Barlow',system-ui; color:#20242b; text-decoration:none; border:1px solid #eceef1; border-radius:999px; padding:.35rem .7rem .35rem .35rem; }
  .routemap a:hover { border-color:#e06e14; color:#e06e14; }
  .routemap a i { font-style:normal; font-weight:800; font-size:.7rem; background:#14171b; color:#fff; border-radius:999px; width:1.35rem; height:1.35rem; display:inline-flex; align-items:center; justify-content:center; }
  .next-cta { display:flex; flex-direction:column; gap:.25rem; border:2px solid #14171b; border-radius:12px; padding:1rem 1.2rem; margin:0 0 1rem; text-decoration:none; background:#fff; }
  .next-cta span { font:700 .68rem/1 'Barlow'; letter-spacing:.14em; color:#e06e14; }
  .next-cta strong { font:800 1.05rem/1.3 'Barlow'; color:#14171b; }
  .next-cta em { font:700 .85rem/1 'Barlow'; font-style:normal; color:#e06e14; }
  .next-cta:hover { border-color:#e06e14; }
</style>
</Base>
