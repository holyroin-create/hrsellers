---
import Page from '../layouts/Page.astro';
import fs from 'node:fs';
import { allClaims } from '../lib/claims';
import Cites from '../components/Cites.astro';
const claims = allClaims();
const qs = (fs.existsSync('data/quiz.json') ? JSON.parse(fs.readFileSync('data/quiz.json', 'utf8')) : [])
  .filter((q: any) => q.claim_ids.every((id: string) => claims.get(id)?.status === 'verified'));
const cites = [...new Set(qs.flatMap((q: any) => q.claim_ids))] as string[];
---
<Page title="Knowledge check: import and fee rules" eyebrow="Quiz" description="Twelve questions on US import rules and marketplace fees that sellers most often get wrong. Each answer explains the rule and links to its primary source." lede={`${qs.length} questions. Pick an answer to see the explanation and the source. Nothing is recorded or sent; your score exists only in this page.`} cites={cites}>
  <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  <p class="meta" id="score" aria-live="polite">0 of {qs.length} answered</p>
  {qs.map((q: any, i: number) => (
    <fieldset class="quiz-q" data-answer={q.answer}>
      <legend>{i + 1}. {q.question}</legend>
      {q.options.map((o: string, k: number) => <label><input type="radio" name={`q${i}`} value={k} /> {o}</label>)}
      <div class="explain"><p><strong class="res"></strong> {q.explanation} <Cites ids={q.claim_ids} /></p>{q.guide && <p><a href={q.guide}>Read the guide</a></p>}</div>
    </fieldset>
  ))}
  <script>
    const qs = [...document.querySelectorAll<HTMLFieldSetElement>('.quiz-q')]; let done = 0, right = 0;
    qs.forEach((f) => f.addEventListener('change', (e) => {
      if (f.classList.contains('answered')) return;
      const v = (e.target as HTMLInputElement).value, ok = v === f.dataset.answer; f.classList.add('answered', ok ? 'right' : 'wrong');
      f.querySelectorAll('input').forEach((i) => (i.disabled = true));
      const correct = f.querySelectorAll('label')[+f.dataset.answer!]; correct.style.fontWeight = '600';
      f.querySelector('.res')!.textContent = ok ? 'Correct.' : 'Not quite.';
      done++; if (ok) right++;
      document.getElementById('score')!.textContent = `${done} of ${qs.length} answered · ${right} correct`;
      (document.getElementById('bar') as HTMLElement).style.width = `${(done / qs.length) * 100}%`;
    }));
  </script>
</Page>
