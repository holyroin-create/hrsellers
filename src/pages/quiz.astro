---
import Page from '../layouts/Page.astro';
import Cites from '../components/Cites.astro';
import { quiz } from '../lib/data';
const qs = quiz();
const cites = [...new Set(qs.flatMap((q: any) => q.claim_ids))];
---
<Page title="Knowledge check: import and marketplace fee rules" description="Test what you know about marketplace fees, US import duties and seller compliance. Every answer explains the rule and links to the official source." kicker="Quiz" photo="hub-faq" lede={`${qs.length} questions. Choose an answer to see the explanation and its source. Nothing is recorded or sent.`} cites={cites}>
  <div class="progress" aria-hidden="true"><span id="bar"></span></div>
  <p class="muted" id="score" aria-live="polite">0 of {qs.length} answered</p>
  {qs.map((q: any, i: number) => (
    <fieldset class="quiz-q" data-answer={q.answer}><legend>{i + 1}. {q.question}</legend>
      <div class="opts">{q.options.map((o: string, k: number) => <label><input type="radio" name={`q${i}`} value={k} />{o}</label>)}</div>
      <div class="explain"><p style="margin:0"><strong class="res"></strong> {q.explanation} <Cites ids={q.claim_ids} /> {q.guide && <a href={q.guide}>Read the guide →</a>}</p></div>
    </fieldset>))}
  <script>
    const qs = [...document.querySelectorAll<HTMLFieldSetElement>('.quiz-q')]; let done = 0, right = 0;
    qs.forEach((f) => f.addEventListener('change', (e) => { if (f.classList.contains('done')) return; const ok = (e.target as HTMLInputElement).value === f.dataset.answer;
      f.classList.add('done', ok ? 'right' : 'wrong'); f.querySelectorAll('input').forEach((i) => (i.disabled = true)); f.querySelectorAll('label')[+f.dataset.answer!].classList.add('correct');
      f.querySelector('.res')!.textContent = ok ? 'Correct.' : 'Not quite.'; done++; if (ok) right++;
      document.getElementById('score')!.textContent = `${done} of ${qs.length} answered · ${right} correct`; (document.getElementById('bar') as HTMLElement).style.width = `${(done / qs.length) * 100}%`; }));
  </script>
</Page>
