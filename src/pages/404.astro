---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="This address does not exist on FBA Tactics. Use search, the guides library or the fee tables to find what you need." noindex noCanonical>
  <section class="section"><div class="wrap narrow" style="text-align:center">
    <span class="kicker">404</span><h1 style="margin:14px 0">We couldn't find that page</h1>
    <p class="muted" style="font-size:1.1rem">The address may be mistyped, or the page was retired when the site was rebuilt in November 2026. Pages that had a close replacement forward to it automatically.</p>
    <form class="hero-search" action="/search/" method="get" role="search" style="margin:28px auto;border:1px solid var(--line)"><Icon name="search" /><label class="vh" for="nq">Search</label><input id="nq" name="q" type="search" placeholder="Search the site" /><button class="btn btn-cta" type="submit">Search</button></form>
    <p><a href="/guides/">Guides</a> · <a href="/marketplaces/">Fee tables</a> · <a href="/tools/">Calculators</a> · <a href="/policy-log/">Policy log</a></p>
  </div></section>
</Base>
