---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on FBA Tactics. Browse the guides, the marketplace fee reference or the policy log instead." noindex={true} noCanonical={true}>
  <div class="wrap page-narrow" style="padding-top:3rem">
    <p class="eyebrow">404</p>
    <h1>This page isn't here</h1>
    <p class="lede">The address may be mistyped, or the page was retired. In November 2026 we removed guides whose figures could not be traced to a primary source; where a close replacement exists, the old address now forwards to it.</p>
    <ul>
      <li><a href="/guides/">All guides</a></li>
      <li><a href="/marketplaces/">Fee reference by marketplace</a></li>
      <li><a href="/policy-log/">Policy log</a></li>
      <li><a href="/sitemap/">Site map</a></li>
    </ul>
  </div>
</Base>
