---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Steps from '../components/Steps.astro';
const road = [
  { t: 'Know what each platform takes', d: 'Fee tables for Amazon, Walmart, eBay, Etsy and Shopify; then run your price through the profit calculator.' },
  { t: 'Decide who imports', d: 'The importer of record owns the duty bill and the compliance duties.' },
  { t: 'Get the duty base right', d: 'Classification sets the rate; country of origin and valuation decide what it applies to.' },
  { t: 'Add up the stack', d: 'General duty, additional duties and federal entry fees on one entry.' },
  { t: 'Check product rules', d: 'Marking, certificates, hazmat shipping and the federal review rule.' },
  { t: 'Keep the money straight', d: 'Inventory and cost of goods sold, Form 1099-K and sales tax.' },
];
const paths = [
  ['tag', 'I sell on one marketplace and want a second', [['/marketplaces/', 'Fee tables'], ['/tools/fee-comparison/', 'Fee comparison'], ['/guides/ebay-etsy-for-amazon-sellers/', 'One item, five platforms']]],
  ['ship', 'I am about to import my first shipment', [['/guides/incoterms-who-is-importer/', 'Who is the importer'], ['/guides/entry-type-11-vs-01/', 'Informal vs formal entry'], ['/guides/customs-bonds/', 'Customs bonds'], ['/tools/duty-estimator/', 'Duty estimator']]],
  ['shield', 'I need to know if my product can be sold as-is', [['/guides/origin-marking-requirements/', 'Origin marking'], ['/guides/us-product-compliance/', 'Product certificates'], ['/guides/hazmat-dangerous-goods/', 'Hazmat shipping']]],
  ['dollar', 'I need my numbers right for tax time', [['/guides/accrual-accounting-cogs/', 'Inventory & COGS'], ['/guides/form-1099-k-marketplace-sellers/', 'Form 1099-K'], ['/guides/sales-tax-nexus/', 'Sales tax']]],
] as const;
---
<Base title="Start here: a roadmap for marketplace sellers" description="Where to begin on FBA Tactics: a six-step roadmap from marketplace fees to import duties, product rules and tax, plus shortcuts for common seller situations.">
  <PageHero title="Start here" kicker="Seller roadmap" photo="hub-guides" lede="The site follows the order money leaves your business: platform fees, then import duties, then compliance and tax. Read in this order, or jump to the situation that matches yours." />
  <div class="wrap" style="padding:56px 24px 88px">
    <div class="duo" style="grid-template-columns:1fr 1fr;align-items:start">
      <div class="prose"><Steps title="The six-step roadmap" steps={road} /></div>
      <div>
        <h2 style="margin-bottom:18px">Jump to your situation</h2>
        <div style="display:grid;gap:14px">{paths.map(([i, t, links]) => <div class="card" style="padding:20px 22px"><h3 style="display:flex;gap:10px;align-items:center;font-size:1.05rem"><span class="chip"><Icon name={i} /></span>{t}</h3><p style="margin:12px 0 0;display:flex;flex-wrap:wrap;gap:8px">{links.map(([u, l]) => <a class="chip chip-orange" href={u}>{l}</a>)}</p></div>)}</div>
      </div>
    </div>
    <div class="prose narrow" style="margin-top:56px">
      <h2>How to read a page here</h2>
      <p>Every guide opens with key figures and a short list of key points, explains the rule, works it through with numbers where there are any, and ends with how to confirm it for your own goods. Small numbered tags link to the source list at the bottom of the page; each source is the agency or platform that sets the rule, with the date it was checked. When you have read a few guides, the <a href="/quiz/">knowledge check</a> is a quick way to see what stuck.</p>
    </div>
  </div>
</Base>
