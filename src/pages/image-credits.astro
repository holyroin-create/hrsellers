---
import Page from '../layouts/Page.astro';
import { images } from '../lib/images';
const list = [...images().values()].sort((a, b) => a.image_id.localeCompare(b.image_id));
---
<Page title="Image credits and licenses" description="Source, author and license for every photograph on FBA Tactics, plus the typefaces used. Photos are illustrative and licensed for commercial use." kicker="Legal" updated="November 8, 2026" wide>
  <p>Every photo is listed with its author, source page and license. Photos are illustrative: they show the kind of place or object a page discusses, not the publisher, its staff, customers or a specific shipment. Charts, diagrams and icons are original work drawn by the site.</p>
  <div class="table-wrap"><table><thead><tr><th>Photo</th><th>Used on</th><th>Author</th><th>Source</th><th>License</th></tr></thead><tbody>
    {list.map((i: any) => <tr><td><img src={`/${i.file}-480.webp`} alt={i.alt} width="120" height={Math.round(120 * i.height / i.width)} loading="lazy" style="border-radius:6px" /></td><td>{(i.pages || []).join(', ')}</td><td>{i.author}</td><td><a href={i.source_url} rel="noopener">{i.library}</a></td><td><a href={i.license_url} rel="noopener license">{i.license}</a></td></tr>)}
  </tbody></table></div>
  <h2>Typefaces</h2><p>Inter, Plus Jakarta Sans and JetBrains Mono, each under the SIL Open Font License 1.1, served from this site.</p>
</Page>
