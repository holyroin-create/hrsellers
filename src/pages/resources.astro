---
import Page from '../layouts/Page.astro';
import { allClaims, hostOf } from '../lib/claims';
const v = [...allClaims().values()].filter((c) => c.status === 'verified' || process.env.ALLOW_UNVERIFIED === '1');
const by = new Map<string, Map<string, number>>();
for (const c of v) { const m = by.get(c.publisher) || new Map(); m.set(c.source_url, (m.get(c.source_url) || 0) + 1); by.set(c.publisher, m); }
const pubs = [...by.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---
<Page title="Primary source directory for sellers" description="Every official document behind the figures on FBA Tactics — regulations, Federal Register notices, IRS publications and marketplace fee pages — grouped by publisher." kicker="Reference" photo="hub-reference" lede="The regulations, notices and fee pages this site relies on, grouped by who publishes them. These change before any summary does — bookmark the ones that govern your business." trail={[{ label: 'Reference', href: '/reference/' }]}>
  <p>{v.length} checked facts come from {[...new Set(v.map((c) => c.source_url))].length} documents published by {pubs.length} sources.</p>
  {pubs.map(([p, urls]) => <><h2 style="font-size:1.15rem">{p}</h2><ul>{[...urls.entries()].map(([u, n]) => <li><a href={u} rel="noopener">{hostOf(u)}{new URL(u).pathname.slice(0, 70)}</a> <span class="muted">— {n} fact{n > 1 ? 's' : ''}</span></li>)}</ul></>)}
</Page>
