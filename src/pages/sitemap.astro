---
import Page from '../layouts/Page.astro';
import { allEntries } from '../lib/entries';
import { PILLARS } from '../lib/pillars';
const all = (await allEntries()).sort((a, b) => a.e.data.title.localeCompare(b.e.data.title));
const fixed = [['/', 'Home'], ['/start-here/', 'Start here'], ['/guides/', 'Guides'], ['/articles/', 'All articles'], ['/marketplaces/', 'Fee tables'], ['/tools/', 'Calculators'], ['/tools/margin-calculator/', 'Profit & margin calculator'], ['/tools/duty-estimator/', 'Duty & entry fee estimator'], ['/tools/fee-comparison/', 'Fee comparison'], ['/tools/dimensional-weight/', 'Dimensional weight'], ['/tools/cash-flow-planner/', 'Cash flow planner'], ['/tools/ppc-budget-calculator/', 'Ad budget & break-even ACoS'], ['/checklists/', 'Checklists'], ['/quiz/', 'Knowledge check'], ['/faq/', 'Seller FAQ'], ['/reference/', 'Reference hub'], ['/reference/key-dates/', 'Key dates'], ['/glossary/', 'Glossary'], ['/resources/', 'Primary sources'], ['/policy-log/', 'Policy log'], ['/about/', 'About'], ['/author/muhammet-ali-turk/', 'Editor: Muhammet Ali TÜRK'], ['/affiliate-disclosure/', 'Affiliate and advertising disclosure'], ['/reviews/', 'Seller software'], ['/editorial-standards/', 'How we check facts'], ['/corrections/', 'Corrections'], ['/contact/', 'Contact'], ['/privacy/', 'Privacy'], ['/cookie-policy/', 'Cookies'], ['/terms/', 'Terms'], ['/disclaimer/', 'Disclaimer'], ['/image-credits/', 'Image credits']];
---
<Page title="Site map" description="Every page on FBA Tactics in one list: guides by topic, marketplace fee tables, calculators, reference pages and site policies." kicker="Navigation" noindex>
  <h2>Pages</h2><ul>{fixed.map(([u, t]) => <li><a href={u}>{t}</a></li>)}</ul>
  {(Object.keys(PILLARS) as (keyof typeof PILLARS)[]).map((k) => <><h2>{PILLARS[k].name}</h2><ul>{all.filter((x) => x.e.data.pillar === k).map((x) => <li><a href={x.href}>{x.e.data.title}</a></li>)}</ul></>)}
</Page>
