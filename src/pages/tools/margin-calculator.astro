---
import Tool from '../../layouts/Tool.astro';
import fs from 'node:fs';
import { isVerified } from '../../lib/claims';
const presets = (fs.existsSync('data/fee-presets.json') ? JSON.parse(fs.readFileSync('data/fee-presets.json', 'utf8')) : []).filter((p: any) => isVerified(p.claim_id) && !p.band);
const markets = [...new Set(presets.map((p: any) => p.marketplace))] as string[];
const cites = [...new Set(presets.map((p: any) => p.claim_id))] as string[];
---
<Tool title="Profit & margin calculator" description="Net profit, margin, return and break-even price per unit after a marketplace's referral or transaction fee, with fee presets from each platform's published fee page." lede="Enter a selling price and your costs; pick a platform fee preset or type your own rate. See what each unit keeps." cites={cites}>
  <form slot="calc" class="calc" id="mc" onsubmit="return false">
    <div class="calc-in"><h2>Your numbers</h2>
      <div class="field"><label for="preset">Fee preset</label><select id="preset">
        <option value="" data-rate="15" data-min="0">Custom rate</option>
        {markets.map((m) => <optgroup label={m}>{presets.filter((p: any) => p.marketplace === m).map((p: any) => <option value={p.claim_id} data-rate={p.rate_pct} data-min={p.min_fee_usd ?? 0}>{p.category} — {p.rate_pct}%{p.min_fee_usd ? ` (min $${p.min_fee_usd})` : ''}</option>)}</optgroup>)}
      </select><span class="hint">Flat-rate categories only. Tiered categories are explained on each <a href="/marketplaces/">fee page</a>.</span></div>
      <div class="field-row">
        <div class="field"><label for="price">Selling price ($)</label><input id="price" type="number" min="0" step="0.01" value="25" inputmode="decimal" /></div>
        <div class="field"><label for="rate">Fee rate (%)</label><input id="rate" type="number" min="0" step="0.1" value="15" inputmode="decimal" /></div>
      </div>
      <div class="field-row">
        <div class="field"><label for="minfee">Minimum fee ($)</label><input id="minfee" type="number" min="0" step="0.01" value="0" inputmode="decimal" /></div>
        <div class="field"><label for="fixed">Other platform fees ($) <span class="hint">Fulfillment, per-order, listing</span></label><input id="fixed" type="number" min="0" step="0.01" value="4" inputmode="decimal" /></div>
      </div>
      <div class="field-row">
        <div class="field"><label for="cogs">Landed cost per unit ($)</label><input id="cogs" type="number" min="0" step="0.01" value="7" inputmode="decimal" /></div>
        <div class="field"><label for="ads">Advertising per unit ($)</label><input id="ads" type="number" min="0" step="0.01" value="2" inputmode="decimal" /></div>
      </div>
      <button class="btn btn-cta" type="submit">Calculate</button>
    </div>
    <div class="calc-out" aria-live="polite"><h2>Per unit</h2>
      <div class="out big"><span>Net profit</span><span class="v" id="o-net">—</span></div>
      <div class="out"><span>Percentage fee</span><span class="v" id="o-fee">—</span></div>
      <div class="out"><span>All platform fees</span><span class="v" id="o-tf">—</span></div>
      <div class="out"><span>Net margin</span><span class="v" id="o-mar">—</span></div>
      <div class="out"><span>Return on landed cost</span><span class="v" id="o-roi">—</span></div>
      <div class="out"><span>Break-even price</span><span class="v" id="o-be">—</span></div>
      <p class="verdict" id="o-v"></p>
    </div>
  </form>
  <h2>How the numbers are worked out</h2>
  <ul>
    <li><strong>Percentage fee</strong> = the greater of price × rate and the minimum fee.</li>
    <li><strong>Net profit</strong> = price − percentage fee − other platform fees − landed cost − advertising.</li>
    <li><strong>Net margin</strong> = net profit ÷ price; <strong>return on landed cost</strong> = net profit ÷ landed cost.</li>
    <li><strong>Break-even price</strong> = (other fees + landed cost + advertising) ÷ (1 − rate), raised if the minimum fee would apply.</li>
  </ul>
  <h2>What the presets cover</h2>
  <p>Each preset is a single published category rate with no price bands, taken from the platform's own fee page on the date shown in the sources below. Some platforms charge the fee on the total including shipping, use different rates above a price threshold, or add fees by size, weight or program. Enter those in “other platform fees” from the platform's current schedule. Sales tax a marketplace collects is not your revenue and is left out.</p>
  <script>
    const el = (id: string) => document.getElementById(id) as HTMLInputElement;
    const $m = (n: number) => (n < 0 ? '−$' : '$') + Math.abs(n).toFixed(2);
    (el('preset') as unknown as HTMLSelectElement).addEventListener('change', (e) => { const o = (e.target as HTMLSelectElement).selectedOptions[0]; if (o.value) { el('rate').value = o.dataset.rate!; el('minfee').value = o.dataset.min!; } run(); });
    function run() {
      const P = +el('price').value, r = +el('rate').value / 100, mn = +el('minfee').value, F = +el('fixed').value, C = +el('cogs').value, A = +el('ads').value;
      const fee = Math.max(P * r, mn), net = P - fee - F - C - A; let be = r < 1 ? (F + C + A) / (1 - r) : Infinity; if (be * r < mn) be = F + C + A + mn;
      el('o-net').textContent = $m(net); el('o-fee').textContent = $m(fee); el('o-tf').textContent = $m(fee + F);
      el('o-mar').textContent = P ? ((net / P) * 100).toFixed(1) + '%' : '—'; el('o-roi').textContent = C ? ((net / C) * 100).toFixed(1) + '%' : '—';
      el('o-be').textContent = isFinite(be) ? $m(be) : '—';
      el('o-v').textContent = net < 0 ? 'At these inputs each unit loses money.' : `Each unit keeps ${$m(net)} after every cost entered.`;
    }
    document.getElementById('mc')!.addEventListener('input', run); document.getElementById('mc')!.addEventListener('submit', run); run();
  </script>
</Tool>
