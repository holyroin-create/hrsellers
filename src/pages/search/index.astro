---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---
<Base title="Search" description="Search FBA Tactics guides, fee tables, calculators and reference pages." noindex>
  <PageHero title="Search" lede="Search guides, fee tables, tools and reference pages." photo="hub-guides">
    <form class="hero-search" action="/search/" method="get" role="search" style="margin-top:24px"><label class="vh" for="sq">Search</label><input id="sq" name="q" type="search" placeholder="Search fees, duties, rules" style="height:48px" /><button class="btn btn-cta" type="submit">Search</button></form>
  </PageHero>
  <div class="wrap narrow" style="padding:40px 24px 88px"><p class="muted" id="st" aria-live="polite"></p><ul class="list-rows" id="res"></ul></div>
  <script>
    const q = new URLSearchParams(location.search).get('q')?.trim() || ''; (document.getElementById('sq') as HTMLInputElement).value = q;
    const st = document.getElementById('st')!, res = document.getElementById('res')!;
    if (!q) st.textContent = 'Type a word or phrase above.';
    else fetch('/search-index.json').then((r) => r.json()).then((docs: any[]) => {
      const terms = q.toLowerCase().split(/\s+/).filter(Boolean);
      const hits = docs.map((d) => { let s = 0; for (const w of terms) { const t = d.t.toLowerCase().includes(w), de = d.d.toLowerCase().includes(w), b = d.b.toLowerCase().includes(w); s += (t ? 6 : 0) + (de ? 3 : 0) + (b ? 1 : 0); if (!t && !de && !b) s -= 10; } return { d, s }; }).filter((x) => x.s > 0).sort((a, b) => b.s - a.s);
      st.textContent = hits.length ? `${hits.length} result${hits.length > 1 ? 's' : ''} for “${q}”` : `No results for “${q}”. Try a shorter term or browse the guides.`;
      for (const { d } of hits) { const li = document.createElement('li'); li.className = 'row-card'; li.style.gridTemplateColumns = '1fr'; const h = document.createElement('h3'); const a = document.createElement('a'); a.href = d.u; a.textContent = d.t; h.append(a); const p = document.createElement('p'); p.textContent = d.d; li.append(h, p); res.append(li); }
    });
  </script>
</Base>
