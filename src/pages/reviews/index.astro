---
import Btn from '../../components/Btn.astro';
import Base from '../../layouts/Base.astro';
---
<Base title="Tool reviews" noindex={true} description="Software reviews for marketplace sellers, scored against a published rubric on paid plans. None published yet.">
<section class="wrap" style="padding:4rem 1.5rem 0">
  <p class="eyebrow">Reviews</p>
  <h1 style="max-width:18ch">Tool reviews</h1>
  <p style="max-width:44ch;color:var(--ink-soft);margin-top:1.2rem">
    <strong>No reviews are published yet.</strong> The scoring rubric is published in advance so the
    standard exists before the first review does. When reviews begin, each will state the plan tier
    tested, the month of testing, and any affiliate relationship with the vendor. Tools are bought at
    list price; vendor-supplied review accounts are declined.
  </p>
  <p style="font-family:var(--display);font-size:.9rem">
    <Btn href="/how-we-test/">Read the rubric</Btn>
  </p>
</section>
</Base>
