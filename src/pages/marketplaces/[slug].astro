---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { MDX } from '../../lib/mdx-components';
import { citeOrder } from '../../lib/cite-order';
export async function getStaticPaths() {
  const all = await getCollection('marketplaces', (e) => !e.data.draft);
  const gd = await getCollection('guides', (e) => !e.data.draft);
  const index = new Map([...gd.map((e) => [e.id, { href: `/guides/${e.id}/`, title: e.data.title, category: e.data.category }]), ...all.map((e) => [e.id, { href: `/marketplaces/${e.id}/`, title: e.data.title, category: e.data.category }])] as any);
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, related: entry.data.related.map((r) => index.get(r)).filter(Boolean) } }));
}
const { entry, related } = Astro.props as any;
(Astro.locals as any).citeOrder = citeOrder(entry.body, entry.data.hero.claim);
const { Content, headings } = await render(entry);
---
<Article data={entry.data} headings={headings} related={related} crumb={{ label: 'Fee reference', href: '/marketplaces/' }} og={`/og/marketplaces/${entry.id}.png`}>
  <Content components={MDX} />
</Article>
