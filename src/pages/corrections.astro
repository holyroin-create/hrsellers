---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Btn from '../components/Btn.astro';
import { AUTHOR } from '../config';

/* One entry per correction. Newest first. Never delete an entry: the point of
   a correction log is that the record of the error outlives the error. */
const CORRECTIONS: { date: string; page: string; href: string; was: string; now: string; why: string }[] = [
  { date: '2026-09-05', page: 'HTS codes: reasonable care and penalties', href: '/guides/hts-classification-basics/', was: 'Negligent misclassification penalty given as the lesser of domestic value or four times the duties.', now: 'Negligence: two times the duties; gross negligence: four times; fraud: full domestic value, per 19 U.S.C. § 1592(c).', why: 'The negligence and gross-negligence tiers had been conflated. Verified against the statute.' },
  { date: '2026-09-05', page: 'Entry Type 11 vs Type 01', href: '/guides/entry-type-11-vs-01/', was: 'Postal shipments described as subject to a flat $80 / $160 / $200 per-package duty.', now: 'The flat option expired February 28, 2026; postal shipments are assessed ad valorem and, since July 24, 2026, require a bonded postal informal entry.', why: 'The flat-duty transition period ended before the article was published. Verified against the CBP interim final rule of June 24, 2026.' },
  { date: '2026-09-05', page: 'FBA shipment discrepancy claims', href: '/guides/shipment-discrepancy-claims/', was: 'Claim window presented as contested between 60 days and nine months.', now: 'Fifteen to sixty days from the shipment delivery date, under Amazon\u2019s policy of September 5, 2024.', why: 'The nine-month figure was the pre-2024 rule. Verified against Amazon\u2019s announcement.' },
  { date: '2026-09-05', page: 'FBA New Selection Program', href: '/guides/new-asin-referral-incentive/', was: 'Described as a referral-fee discount on the first $25,000 in sales per new ASIN.', now: 'A referral-fee cap of 10% on the first 100 units and 5% on the next 100 units per new-to-FBA branded parent ASIN, from July 30, 2026. The dollar tiers belong to the separate New Seller Incentives program.', why: 'Two Amazon programs had been conflated from a secondhand news summary.' },
  { date: '2026-09-04', page: 'Amazon deal and coupon fees', href: '/guides/deal-and-coupon-fees/', was: 'The $70-per-day-plus-1% structure described as a superseded arrangement.', now: 'That is the current structure for deals outside peak events (since June 2, 2025); peak events use $100 plus 1.5%, capped at $5,000.', why: 'Two concurrent fee structures had been read as one replacing the other. Verified against Amazon\u2019s March 2025 and July 2026 announcements.' },
  { date: '2026-09-04', page: 'Amazon listing optimization', href: '/guides/listing-optimisation-a10/', was: 'Title limit presented as unresolved between 200 characters and 75 characters.', now: '75 characters in all categories except media since July 27, 2026, with a 125-character Item Highlights field; 200 was the January 2025 rule.', why: 'Both figures were correct on different dates. The July 2026 change had not been incorporated.' },
  { date: '2026-09-04', page: 'FBA storage fees', href: '/guides/fba-storage-four-layers/', was: 'A change effective July 1, 2026 raising the standard-size rate to $0.87 per cubic foot and moving the aged-inventory trigger to 180 days.', now: 'No such change occurred. Standard-size storage is $0.78 per cubic foot off-peak in 2026, and the aged-inventory surcharge has started at day 181 since 2023.', why: 'The figure traced to a single vendor blog and to nothing Amazon published. Verified against Amazon\u2019s 2026 fee pages. The same error was removed from the Walmart WFS and removal-decision guides.' },
  { date: '2026-09-04', page: 'Low-inventory-level fee', href: '/guides/low-inventory-level-fee/', was: 'Threshold presented as uncertain between 28 and 35 days of supply.', now: '28 days, on both the 30-day and 90-day windows, per Amazon.', why: 'The 35-day figure came from one vendor blog and does not appear in Amazon\u2019s documentation.' },
];
---
<Base title="Corrections" description="The correction policy for this site and a dated log of every change made to a published figure or claim.">
<div class="wrap"><Breadcrumbs trail={[{ label: 'Corrections', href: '/corrections/' }]} /></div>
<section class="wrap" style="padding:1.5rem 1.25rem 0">
  <p class="eyebrow">Log</p>
  <h1 style="max-width:20ch">Corrections</h1>
  <p style="max-width:46ch;font-size:1.12rem;color:var(--ink-soft);margin:1.2rem 0 1.8rem">
    A site that publishes dated figures will get some of them wrong. What separates a reference from a
    blog is what happens next, and whether you can see it happen.
  </p>

  <div class="prose">
    <h2>The log</h2>
    {CORRECTIONS.length === 0 ? (
      <p class="note">
        No corrections have been issued yet. This site began publishing dated figures in August 2026;
        the log is empty because it is new, not because nothing will ever appear here. If you find an
        error before we do, the first entry will be yours.
      </p>
    ) : (
      <table>
        <thead><tr><th>Date</th><th>Page</th><th>What changed</th></tr></thead>
        <tbody>
          {CORRECTIONS.map(c => (
            <tr>
              <td>{c.date}</td>
              <td><a href={c.href}>{c.page}</a></td>
              <td><strong>Was:</strong> {c.was}<br /><strong>Now:</strong> {c.now}<br /><span class="note">{c.why}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    )}

    <h2>What counts as a correction</h2>
    <p>
      Anything that would change a reader's decision. A wrong fee rate, a wrong effective date, a
      misattributed source, an arithmetic error in a worked example, a claim that turns out not to be
      supported by the source cited for it. All of these get a dated note on the article and an entry here.
    </p>
    <p>
      Fixing a typo, a broken link or a clumsy sentence is not a correction and does not get logged.
      Nothing about the substance changed, and a log that fills up with punctuation edits stops being
      useful for the thing it exists to record.
    </p>

    <h2>Updates are not corrections either</h2>
    <p>
      When a marketplace changes a fee, the figure that was published was not wrong — it was true on the
      date it carried. Those pages get a revised modified date and, where the change is material, a note
      explaining what moved and when. That is a normal part of maintaining a dated reference, and it is
      recorded differently from an error on our part. Platform-side changes are tracked on the{' '}
      <a href="/policy-log/">fee and policy log</a>.
    </p>

    <h2>What a correction looks like on the page</h2>
    <p>
      The wrong figure is replaced in the body text, so nobody reads the error by accident. A dated note
      is added at the foot of the article stating what the figure previously said, what it says now, and
      why it changed. The article's modified date is updated. Then it is logged here.
    </p>
    <p>
      What does not happen: quietly editing the number and leaving the page looking as though it always
      said that. If a figure here moves, you should be able to find out that it moved.
    </p>

    <h2>How to report one</h2>
    <p>
      Email <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>. The report is far more useful with three
      things in it:
    </p>
    <ol>
      <li>The page, and ideally the section or the sentence.</li>
      <li>What you believe the correct figure or claim is.</li>
      <li>Where it comes from — a link to the marketplace's own documentation is ideal.</li>
    </ol>
    <p>
      Reports are read by <a href="/about/">the author</a>. Where a correction is warranted, the aim is to
      publish it within 48 hours. Where it is not, you will get a reply explaining why, with the source the
      original figure rests on. Disagreement about which of several published figures is current is common
      in this subject and is usually worth the exchange — several pages on this site now carry a table of
      contested figures because two sources could not be reconciled.
    </p>

    <div class="btn-row" style="margin-top:2rem">
      <Btn href="/editorial-standards/">Editorial standards</Btn>
      <Btn href="/policy-log/" quiet={true}>Platform change log</Btn>
    </div>
  </div>
</section>
</Base>
