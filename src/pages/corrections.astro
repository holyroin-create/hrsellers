---
import Page from '../layouts/Page.astro';
import fs from 'node:fs';
import { fmtDate } from '../lib/claims';
const list = JSON.parse(fs.readFileSync('data/corrections.json', 'utf8')).sort((a: any, b: any) => b.date.localeCompare(a.date));
---
<Page title="Corrections" eyebrow="Standards" description="A dated public log of every correction and material change to figures published on FBA Tactics, and how to report an error." lede="When we get something wrong or a published figure changes, it is recorded here with the date and the reason.">
  <p>To report an error, email the address on the <a href="/contact/">contact page</a> with the page, the statement, and the primary source that shows the correct value.</p>
  <table><thead><tr><th>Date</th><th>Page</th><th>What changed</th><th>Why</th></tr></thead>
    <tbody>{list.map((c: any) => <tr><td style="white-space:nowrap">{fmtDate(c.date)}</td><td>{c.page.startsWith('/') ? <a href={c.page}>{c.page}</a> : c.page}</td><td>{c.change}</td><td>{c.why}</td></tr>)}</tbody></table>
</Page>
