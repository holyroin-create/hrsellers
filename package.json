{
  "name": "fbatactics",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node tools/make-og.mjs",
    "build": "astro build",
    "postbuild": "node tools/postbuild.mjs",
    "preview": "astro preview",
    "gate:claims": "node tools/gate-claims.mjs",
    "gate:images": "node tools/gate-images.mjs",
    "gate:policy": "node tools/gate-policy.mjs",
    "gate:links": "node tools/gate-links.mjs",
    "gate:html": "node tools/list-html.mjs | xargs html-validate",
    "check": "npm run build && npm run gate:claims && npm run gate:images && npm run gate:policy && npm run gate:links && npm run gate:html",
    "recheck": "node tools/weekly-recheck.mjs",
    "export:claims": "node tools/export-claims.mjs",
    "merge:images": "node tools/merge-images.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "html-validate": "11.19.0"
  }
}
