{
  "name": "fbatactics",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "gate:claims": "node tools/gate-claims.mjs",
    "gate:images": "node tools/gate-images.mjs",
    "gate:policy": "node tools/gate-policy.mjs",
    "gate:html": "node tools/list-html.mjs | xargs html-validate",
    "gate:links": "node tools/gate-links.mjs",
    "gate:all": "npm run gate:claims && npm run gate:images && npm run gate:policy && npm run gate:links",
    "check": "npm run build && npm run gate:all && npm run gate:html",
    "prebuild": "node tools/make-og.mjs",
    "postbuild": "node tools/make-redirects.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "astro": "7.4.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "html-validate": "11.19.0"
  }
}